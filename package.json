{
  "name": "baraonda-fiorentina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Asset pipeline (Tailwind + Alpine + TypeScript) del sito Baraonda Fiorentina. Node serve SOLO in sviluppo: la produzione riceve gli asset gia compilati.",
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('public/assets',{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/alpinejs": "^3.13.10",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.16.2",
    "@alpinejs/csp": "^3.16.2",
    "@alpinejs/focus": "^3.14.3",
    "alpinejs": "^3.14.3"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "iOS >= 14",
    "Safari >= 14"
  ]
}
