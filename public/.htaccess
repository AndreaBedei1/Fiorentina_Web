# =============================================================================
#  Baraonda Fiorentina - configurazione Apache della cartella pubblica
# =============================================================================
#  Testato per Aruba Linux Easy (Apache + mod_rewrite + mod_headers +
#  mod_deflate + mod_expires). Ogni blocco e protetto da <IfModule>: se un
#  modulo non e attivo il sito continua a funzionare, semplicemente senza
#  quella ottimizzazione.
# =============================================================================

# -----------------------------------------------------------------------------
#  Indirizzi puliti
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Su alcuni hosting condivisi il sito non sta nella radice del dominio:
    # RewriteBase evita redirect verso percorsi sbagliati.
    # RewriteBase /

    # Forza HTTPS. Da attivare dopo aver installato il certificato dal pannello.
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Rimuove la barra finale dagli indirizzi (tranne la home): evita che la
    # stessa pagina sia raggiungibile a due indirizzi diversi.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # File e cartelle esistenti vengono serviti direttamente da Apache:
    # e cio che rende immediate immagini, CSS e JavaScript.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tutto il resto passa dal front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# -----------------------------------------------------------------------------
#  Intestazioni di sicurezza
# -----------------------------------------------------------------------------
#  Duplicano quelle impostate da SecurityHeadersMiddleware: se un giorno il
#  front controller non venisse raggiunto, le protezioni restano comunque.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Da attivare solo con HTTPS gia funzionante: con HSTS attivo un
    # certificato mancante rende il sito irraggiungibile.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Gli asset compilati hanno un hash nel nome: sono immutabili.
    <FilesMatch "\.(css|js|woff2?|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Le pagine HTML non vanno messe in cache dai proxy.
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "private, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
#  Compressione
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
#  Scadenze cache
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------------------
#  Tipi MIME
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
#  Accessi negati
# -----------------------------------------------------------------------------
#  Nella cartella uploads finiscono file caricati dagli amministratori: anche
#  se la validazione impedisce di salvare altro che immagini, qui blocchiamo
#  in modo esplicito l'esecuzione di qualsiasi script.
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|htaccess)$ - [F,L,NC]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|log|sql|md|json|lock|dist|bak|sh)$">
    Require all denied
</FilesMatch>

# Il manifest di Vite serve solo a PHP, non al browser.
<Files "manifest.json">
    Require all denied
</Files>

# Indice delle cartelle disattivato: nessuno deve poter sfogliare i file.
Options -Indexes

# -----------------------------------------------------------------------------
#  Pagine di errore servite dal front controller
# -----------------------------------------------------------------------------
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

# -----------------------------------------------------------------------------
#  PHP (Aruba consente di sovrascrivere alcune direttive)
# -----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 32M
    php_value post_max_size 128M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
