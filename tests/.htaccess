# Questa cartella non deve essere raggiungibile via HTTP.
# Il document root corretto e public/: se il pannello dell'hosting non permette
# di impostarlo, queste regole restano l'ultima difesa.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (alcuni hosting condivisi lo usano ancora)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
