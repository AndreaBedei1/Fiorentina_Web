{% extends 'emails/layout.twig' %}

{% set preheader = 'Ordine ' ~ order.orderNumber ~ ' ricevuto. Ecco il riepilogo e come completare il pagamento.' %}
{% set headerNote = 'Conferma ordine' %}

{% block content %}
    <p style="margin:0 0 16px; font-size:20px; font-weight:700; color:#2c1640;">
        Ciao {{ order.customerFirstName }}, abbiamo ricevuto il tuo ordine
    </p>

    <p style="margin:0 0 20px; font-size:15px; line-height:1.65;">
        Grazie per il sostegno. Qui sotto trovi il riepilogo e le istruzioni per completare il pagamento.
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f6f3fb; border:1px solid #d8c9ee; border-radius:10px; margin-bottom:24px;">
        <tr>
            <td style="padding:16px 18px;">
                <p style="margin:0; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#6b3aa0;">Numero d'ordine</p>
                <p style="margin:4px 0 0; font-size:22px; font-weight:800; letter-spacing:0.03em; color:#2c1640;">{{ order.orderNumber }}</p>
                <p style="margin:8px 0 0; font-size:13px; color:#57504a;">Data: {{ order.createdAt|data_ora }}</p>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 10px; font-size:13px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#82766a;">Articoli</p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; margin-bottom:20px;">
        {% for item in items %}
            <tr>
                <td style="padding:10px 0; border-bottom:1px solid #e7e3dc; font-size:14px; line-height:1.5;">
                    <strong style="color:#2c1640;">{{ item.productName }}</strong>
                    {% if item.variantLabel %}<br><span style="color:#82766a;">{{ item.variantLabel }}</span>{% endif %}
                    <br><span style="color:#82766a;">{{ item.quantity }} x {{ item.unitPrice|euro }}</span>
                </td>
                <td align="right" style="padding:10px 0; border-bottom:1px solid #e7e3dc; font-size:14px; font-weight:700; color:#2c1640; white-space:nowrap;">
                    {{ item.lineTotal|euro }}
                </td>
            </tr>
        {% endfor %}

        <tr>
            <td style="padding:10px 0; font-size:14px; color:#57504a;">Subtotale</td>
            <td align="right" style="padding:10px 0; font-size:14px; color:#57504a;">{{ order.subtotal|euro }}</td>
        </tr>
        <tr>
            <td style="padding:0 0 10px; font-size:14px; color:#57504a;">
                {{ order.isPickup ? 'Ritiro in sede' : 'Spedizione' }}
            </td>
            <td align="right" style="padding:0 0 10px; font-size:14px; color:#57504a;">
                {{ order.shippingCost > 0 ? order.shippingCost|euro : 'gratuita' }}
            </td>
        </tr>
        <tr>
            <td style="padding:12px 0 0; border-top:2px solid #41215f; font-size:16px; font-weight:800; color:#2c1640;">Totale</td>
            <td align="right" style="padding:12px 0 0; border-top:2px solid #41215f; font-size:18px; font-weight:800; color:#2c1640;">{{ order.total|euro }}</td>
        </tr>
    </table>

    <p style="margin:0 0 10px; font-size:13px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#82766a;">
        {{ order.isPickup ? 'Ritiro' : 'Consegna' }}
    </p>
    <p style="margin:0 0 24px; font-size:14px; line-height:1.65; color:#57504a;">
        {{ order.customerName }}<br>
        {{ order.shippingLine }}<br>
        {{ order.customerEmail }} - {{ order.customerPhone }}
    </p>

    {% if payment_instructions %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
               style="background-color:#fef2f3; border:1px solid #fbccd2; border-radius:10px; margin-bottom:24px;">
            <tr>
                <td style="padding:16px 18px;">
                    <p style="margin:0 0 8px; font-size:15px; font-weight:700; color:#7b1634;">Come completare il pagamento</p>
                    <p style="margin:0; font-size:14px; line-height:1.65; color:#57504a; white-space:pre-line;">{{ payment_instructions }}</p>
                </td>
            </tr>
        </table>
    {% endif %}

    <p style="margin:0 0 8px; font-size:14px; line-height:1.65;">
        Nessun pagamento è stato effettuato su questo sito: la tua richiesta è registrata e verrà
        confermata dal responsabile merchandising.
    </p>

    <p style="margin:0; font-size:14px; line-height:1.65;">
        Per qualsiasi domanda rispondi a questa email oppure scrivi a
        <a href="mailto:{{ contact_email }}" style="color:#582d84;">{{ contact_email }}</a>.
    </p>
{% endblock %}
