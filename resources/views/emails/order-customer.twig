{% extends 'emails/layout.twig' %}

{% set preheader = 'Ordine ' ~ order.orderNumber ~ ' ricevuto. Ecco il riepilogo e come completare il pagamento.' %}
{% set headerNote = 'Conferma ordine' %}

{% block content %}
    <p style="margin:0 0 16px; font-size:20px; font-weight:700; color:#221547;">
        Ciao {{ order.customerFirstName }}, abbiamo ricevuto il tuo ordine
    </p>

    <p style="margin:0 0 20px; font-size:15px; line-height:1.65;">
        Grazie per il sostegno. Qui sotto trovi il riepilogo e le istruzioni per completare il pagamento.
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f5f3fc; border:1px solid #d4c8f5; border-radius:10px; margin-bottom:24px;">
        <tr>
            <td style="padding:16px 18px;">
                <p style="margin:0; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#482e92;">Numero d'ordine</p>
                <p style="margin:4px 0 0; font-size:22px; font-weight:800; letter-spacing:0.03em; color:#221547;">{{ order.orderNumber }}</p>
                <p style="margin:8px 0 0; font-size:13px; color:#57504a;">Data: {{ order.createdAt|data_ora }}</p>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 10px; font-size:13px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#7a6f63;">Articoli</p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; margin-bottom:20px;">
        {% for item in items %}
            <tr>
                <td style="padding:10px 0; border-bottom:1px solid #e7e3dc; font-size:14px; line-height:1.5;">
                    <strong style="color:#221547;">{{ item.productName }}</strong>
                    {% if item.variantLabel %}<br><span style="color:#7a6f63;">{{ item.variantLabel }}</span>{% endif %}
                    <br><span style="color:#7a6f63;">{{ item.quantity }} x {{ item.unitPrice|euro }}</span>
                </td>
                <td align="right" style="padding:10px 0; border-bottom:1px solid #e7e3dc; font-size:14px; font-weight:700; color:#221547; white-space:nowrap;">
                    {{ item.lineTotal|euro }}
                </td>
            </tr>
        {% endfor %}

        <tr>
            <td style="padding:12px 0 0; border-top:2px solid #2f1d64; font-size:16px; font-weight:800; color:#221547;">Totale articoli</td>
            <td align="right" style="padding:12px 0 0; border-top:2px solid #2f1d64; font-size:18px; font-weight:800; color:#221547;">{{ order.total|euro }}</td>
        </tr>
    </table>

    <p style="margin:0 0 24px; font-size:13px; line-height:1.6; color:#7a6f63;">
        La spedizione non è compresa in questo importo: ti diciamo noi quanto costa
        quando ti contattiamo per il pagamento.
    </p>

    <p style="margin:0 0 10px; font-size:13px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#7a6f63;">
        Consegna
    </p>
    <p style="margin:0 0 24px; font-size:14px; line-height:1.65; color:#57504a;">
        {{ order.customerName }}<br>
        {{ order.shippingLine }}<br>
        {{ order.customerEmail }} - {{ order.customerPhone }}
    </p>

    {% if payment_instructions %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
               style="background-color:#fef2f3; border:1px solid #fbccd2; border-radius:10px; margin-bottom:24px;">
            <tr>
                <td style="padding:16px 18px;">
                    <p style="margin:0 0 8px; font-size:15px; font-weight:700; color:#7b1634;">Come completare il pagamento</p>
                    <p style="margin:0; font-size:14px; line-height:1.65; color:#57504a; white-space:pre-line;">{{ payment_instructions }}</p>
                </td>
            </tr>
        </table>
    {% endif %}

    <p style="margin:0 0 8px; font-size:14px; line-height:1.65;">
        Nessun pagamento è stato effettuato su questo sito: la tua richiesta è registrata e verrà
        confermata dal responsabile merchandising.
    </p>

    <p style="margin:0; font-size:14px; line-height:1.65;">
        Per qualsiasi domanda rispondi a questa email oppure scrivi a
        <a href="mailto:{{ contact_email }}" style="color:#3b247d;">{{ contact_email }}</a>.
    </p>
{% endblock %}
