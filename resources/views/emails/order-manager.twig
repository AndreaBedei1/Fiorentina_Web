{% extends 'emails/layout.twig' %}

{% set preheader = 'Nuovo ordine ' ~ order.orderNumber ~ ' da ' ~ order.customerName ~ ' - ' ~ order.total|euro %}
{% set headerNote = 'Nuovo ordine dal sito' %}

{% block content %}
    <p style="margin:0 0 6px; font-size:20px; font-weight:700; color:#221547;">Nuovo ordine {{ order.orderNumber }}</p>
    <p style="margin:0 0 22px; font-size:14px; color:#7a6f63;">Ricevuto il {{ order.createdAt|data_ora }}</p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f5f3fc; border:1px solid #d4c8f5; border-radius:10px; margin-bottom:22px;">
        <tr>
            <td style="padding:16px 18px; font-size:14px; line-height:1.7; color:#3d3833;">
                <strong style="color:#221547;">{{ order.customerName }}</strong><br>
                Email: <a href="mailto:{{ order.customerEmail }}" style="color:#3b247d;">{{ order.customerEmail }}</a><br>
                Telefono: <a href="tel:{{ order.customerPhone|replace({' ': ''}) }}" style="color:#3b247d;">{{ order.customerPhone }}</a><br>
                <br>
                <strong style="color:#221547;">Spedire a</strong><br>
                {{ order.shippingLine }}
            </td>
        </tr>
    </table>

    <p style="margin:0 0 10px; font-size:13px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#7a6f63;">Articoli richiesti</p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; margin-bottom:20px;">
        <tr>
            <th align="left" style="padding:8px 0; border-bottom:2px solid #2f1d64; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#57504a;">Prodotto</th>
            <th align="center" style="padding:8px 0; border-bottom:2px solid #2f1d64; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#57504a;">Qta</th>
            <th align="right" style="padding:8px 0; border-bottom:2px solid #2f1d64; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#57504a;">Totale</th>
        </tr>
        {% for item in items %}
            <tr>
                <td style="padding:10px 0; border-bottom:1px solid #e7e3dc; font-size:14px; line-height:1.5;">
                    <strong style="color:#221547;">{{ item.productName }}</strong>
                    {% if item.variantLabel %}<br><span style="color:#7a6f63;">Variante: {{ item.variantLabel }}</span>{% endif %}
                    <br><span style="color:#7a6f63;">{{ item.unitPrice|euro }} cadauno</span>
                </td>
                <td align="center" style="padding:10px 0; border-bottom:1px solid #e7e3dc; font-size:14px; font-weight:700; color:#221547;">{{ item.quantity }}</td>
                <td align="right" style="padding:10px 0; border-bottom:1px solid #e7e3dc; font-size:14px; font-weight:700; color:#221547; white-space:nowrap;">{{ item.lineTotal|euro }}</td>
            </tr>
        {% endfor %}
        <tr>
            <td colspan="2" style="padding:12px 0 0; border-top:2px solid #2f1d64; font-size:16px; font-weight:800; color:#221547;">Totale articoli</td>
            <td align="right" style="padding:12px 0 0; border-top:2px solid #2f1d64; font-size:18px; font-weight:800; color:#221547;">{{ order.total|euro }}</td>
        </tr>
    </table>

    <p style="margin:0 0 22px; font-size:13px; line-height:1.6; color:#7a6f63;">
        Spedizione esclusa: il costo va concordato con il cliente insieme al pagamento.
    </p>

    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td style="background-color:#cd2247; border-radius:8px;">
                <a href="{{ site_url }}/admin/ordini/{{ order.id }}"
                   style="display:inline-block; padding:12px 22px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none;">
                    Apri l'ordine nel pannello
                </a>
            </td>
        </tr>
    </table>

    <p style="margin:18px 0 0; font-size:13px; line-height:1.6; color:#7a6f63;">
        Rispondendo a questa email scrivi direttamente al cliente.
    </p>
{% endblock %}
