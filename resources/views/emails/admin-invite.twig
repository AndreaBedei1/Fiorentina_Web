{% extends 'emails/layout.twig' %}

{% set preheader = 'Attiva il tuo accesso al pannello di ' ~ setting('site_group_name', 'Baraonda Fiorentina') %}
{% set headerNote = 'Invito alla gestione del sito' %}

{% block content %}
    <p style="margin:0 0 16px; font-size:20px; font-weight:700; color:#2c1640;">Ciao {{ name }},</p>

    <p style="margin:0 0 20px; font-size:15px; line-height:1.65;">
        {{ inviter }} ti ha invitato a gestire il sito di {{ setting('site_group_name', 'Baraonda Fiorentina') }}
        con il ruolo di <strong>{{ role_label }}</strong>.
    </p>

    <p style="margin:0 0 22px; font-size:15px; line-height:1.65;">
        Per attivare l'accesso scegli una password personale dal collegamento qui sotto.
    </p>

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:22px;">
        <tr>
            <td style="background-color:#cd2247; border-radius:8px;">
                <a href="{{ link }}" style="display:inline-block; padding:14px 26px; font-size:16px; font-weight:700; color:#ffffff; text-decoration:none;">
                    Attiva il tuo account
                </a>
            </td>
        </tr>
    </table>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#faf9f7; border:1px solid #e7e3dc; border-radius:10px; margin-bottom:20px;">
        <tr>
            <td style="padding:14px 16px; font-size:13px; line-height:1.7; color:#57504a;">
                Il collegamento è valido per <strong>{{ expires_hours }} ore</strong> e può essere usato una sola volta.<br>
                Se non funziona, copialo e incollalo nella barra degli indirizzi:<br>
                <span style="word-break:break-all; color:#582d84;">{{ link }}</span>
            </td>
        </tr>
    </table>

    <p style="margin:0; font-size:13px; line-height:1.6; color:#82766a;">
        Se non ti aspettavi questo invito puoi ignorare il messaggio: senza aprire il collegamento
        l'account resta inattivo.
    </p>
{% endblock %}
