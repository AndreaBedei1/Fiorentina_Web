{# Percorso di navigazione. L'ultima voce e la pagina corrente e non e un link. #}
<nav aria-label="Percorso di navigazione" class="border-b border-sabbia-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
        <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-sabbia-600" role="list">
            {% for crumb in crumbs %}
                <li class="flex items-center gap-1.5">
                    {% if not loop.last %}
                        <a href="{{ crumb.url }}" class="rounded transition hover:text-viola-800 hover:underline focus-ring">{{ crumb.name }}</a>
                        <span class="text-sabbia-400" aria-hidden="true">/</span>
                    {% else %}
                        <span class="font-medium text-viola-900" aria-current="page">{{ crumb.name|taglia(60) }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </div>
</nav>
