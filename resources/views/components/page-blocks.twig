{#
  Rende i blocchi di una pagina editoriale.

  I tipi sono fissi e pochi: elenco, passaggi, riquadro in evidenza, invito
  all'azione, domande frequenti, numeri chiave, linea del tempo. E una scelta
  precisa: un costruttore di pagine libero permetterebbe di scomporre il layout,
  e il sito diventerebbe impossibile da mantenere per chi lo eredita.

  I titoli dei blocchi sono h2, quindi restano sotto l'h1 della pagina.
#}
{% for block in blocks %}

    {# ---------- ELENCO PUNTATO ---------- #}
    {% if block.type == 'list' %}
        <section class="mt-12">
            {% if block.title %}<h2 class="font-display text-2xl font-bold text-viola-900">{{ block.title }}</h2>{% endif %}
            {% if block.subtitle %}<p class="mt-2 text-base text-sabbia-700">{{ block.subtitle }}</p>{% endif %}

            <ul class="mt-6 grid gap-4 sm:grid-cols-2" role="list">
                {% for item in block.items %}
                    <li class="flex gap-3 rounded-card bg-white p-4 shadow-card">
                        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rosso-100 text-rosso-700">
                            {{ include('components/icon.twig', { name: 'check', class: 'h-4 w-4' }) }}
                        </span>
                        <div class="min-w-0">
                            <p class="font-display text-base font-bold text-viola-900">{{ item.title }}</p>
                            {% if item.text %}<p class="mt-1 text-sm leading-relaxed text-sabbia-700">{{ item.text }}</p>{% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>

    {# ---------- PASSAGGI NUMERATI ---------- #}
    {% elseif block.type == 'steps' %}
        <section class="mt-12">
            {% if block.title %}<h2 class="font-display text-2xl font-bold text-viola-900">{{ block.title }}</h2>{% endif %}
            {% if block.subtitle %}<p class="mt-2 text-base text-sabbia-700">{{ block.subtitle }}</p>{% endif %}

            <ol class="mt-6 grid gap-4 sm:grid-cols-3">
                {% for item in block.items %}
                    <li class="relative rounded-card bg-white p-5 shadow-card">
                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-viola-800 font-display text-base font-extrabold text-white">
                            {{ loop.index }}
                        </span>
                        <p class="mt-3 font-display text-base font-bold text-viola-900">{{ item.title }}</p>
                        {% if item.text %}<p class="mt-1.5 text-sm leading-relaxed text-sabbia-700">{{ item.text }}</p>{% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>

    {# ---------- NUMERI CHIAVE ---------- #}
    {% elseif block.type == 'stats' %}
        <section class="mt-12">
            {% if block.title %}<h2 class="font-display text-2xl font-bold text-viola-900">{{ block.title }}</h2>{% endif %}
            {% if block.subtitle %}<p class="mt-2 text-sm text-sabbia-600">{{ block.subtitle }}</p>{% endif %}

            <dl class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
                {% for item in block.items %}
                    <div class="rounded-card bg-viola-900 p-5 text-center">
                        <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-viola-300">{{ item.title }}</dt>
                        <dd class="mt-2 font-display text-2xl font-extrabold text-white sm:text-3xl">{{ item.text }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </section>

    {# ---------- LINEA DEL TEMPO ---------- #}
    {% elseif block.type == 'timeline' %}
        <section class="mt-12">
            {% if block.title %}<h2 class="font-display text-2xl font-bold text-viola-900">{{ block.title }}</h2>{% endif %}
            {% if block.subtitle %}<p class="mt-2 text-sm text-sabbia-600">{{ block.subtitle }}</p>{% endif %}

            <ol class="relative mt-6 space-y-6 border-l-2 border-viola-200 pl-6">
                {% for item in block.items %}
                    <li class="relative">
                        <span class="absolute -left-[1.9rem] top-1 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-rosso-600" aria-hidden="true"></span>
                        <p class="font-display text-lg font-extrabold text-viola-900">{{ item.title }}</p>
                        {% if item.text %}<p class="mt-1 text-sm leading-relaxed text-sabbia-700">{{ item.text }}</p>{% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>

    {# ---------- DOMANDE FREQUENTI ---------- #}
    {% elseif block.type == 'faq' %}
        <section class="mt-12">
            {% if block.title %}<h2 class="font-display text-2xl font-bold text-viola-900">{{ block.title }}</h2>{% endif %}

            <div class="mt-6 divide-y divide-sabbia-200 overflow-hidden rounded-panel bg-white shadow-card">
                {% for item in block.items %}
                    {#
                      details/summary nativi: si aprono e chiudono senza
                      JavaScript, sono accessibili da tastiera e vengono letti
                      correttamente dagli screen reader.
                    #}
                    <details class="group">
                        <summary class="flex cursor-pointer items-center justify-between gap-3 px-5 py-4 font-display text-base font-bold text-viola-900 focus-ring">
                            {{ item.title }}
                            <span class="shrink-0 text-viola-500 transition-transform group-open:rotate-180 motion-reduce:transform-none">
                                {{ include('components/icon.twig', { name: 'chevron-down', class: 'h-5 w-5' }) }}
                            </span>
                        </summary>
                        {% if item.text %}
                            <div class="px-5 pb-4 text-sm leading-relaxed text-sabbia-700">{{ item.text }}</div>
                        {% endif %}
                    </details>
                {% endfor %}
            </div>
        </section>

    {# ---------- RIQUADRO IN EVIDENZA ---------- #}
    {% elseif block.type == 'highlight' %}
        <section class="mt-12">
            <div class="rounded-panel border-l-4 border-rosso-600 bg-white p-6 shadow-card">
                {% if block.title %}
                    <h2 class="flex items-center gap-2 font-display text-xl font-bold text-viola-900">
                        {% if block.icon %}
                            <span class="text-rosso-600">{{ include('components/icon.twig', { name: block.icon, class: 'h-5 w-5' }) }}</span>
                        {% endif %}
                        {{ block.title }}
                    </h2>
                {% endif %}
                {% if block.body %}<div class="contenuto mt-3">{{ block.body|raw }}</div>{% endif %}
            </div>
        </section>

    {# ---------- INVITO ALL AZIONE ---------- #}
    {% elseif block.type == 'cta' %}
        <section class="mt-12">
            <div class="rounded-panel bg-gradient-to-br from-viola-800 to-viola-950 p-6 text-center sm:p-9">
                {% if block.title %}
                    <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">{{ block.title }}</h2>
                {% endif %}
                {% if block.body %}
                    <div class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-viola-100 [&_p]:m-0">{{ block.body|raw }}</div>
                {% endif %}
                {% if block.linkUrl and block.linkLabel %}
                    <a href="{{ block.linkUrl }}"
                       class="mt-6 inline-flex items-center gap-2 rounded-lg bg-rosso-600 px-6 py-3.5 text-base font-bold text-white transition hover:bg-rosso-700 focus-ring-light">
                        {{ block.linkLabel }}
                        {{ include('components/icon.twig', { name: 'arrow-right', class: 'h-5 w-5' }) }}
                    </a>
                {% endif %}
            </div>
        </section>

    {# ---------- TESTO LIBERO ---------- #}
    {% else %}
        <section class="mt-12">
            {% if block.title %}<h2 class="font-display text-2xl font-bold text-viola-900">{{ block.title }}</h2>{% endif %}
            {% if block.subtitle %}<p class="mt-2 text-base text-sabbia-700">{{ block.subtitle }}</p>{% endif %}
            {% if block.body %}<div class="contenuto mt-4">{{ block.body|raw }}</div>{% endif %}
        </section>
    {% endif %}

{% endfor %}
