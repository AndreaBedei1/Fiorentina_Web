{# Stato vuoto di una tabella o di un elenco del pannello. #}
<div class="px-6 py-14 text-center">
    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-sabbia-100 text-sabbia-500">
        {{ include('components/icon.twig', { name: icon|default('info'), class: 'h-6 w-6' }) }}
    </span>
    <p class="mt-3 font-display text-base font-bold text-viola-900">{{ title }}</p>
    {% if message is defined and message %}
        <p class="mx-auto mt-1.5 max-w-sm text-sm leading-relaxed text-sabbia-600">{{ message }}</p>
    {% endif %}
    {% if action is defined and action %}
        <a href="{{ action.url }}" class="btn-primario mt-5">
            {{ include('components/icon.twig', { name: 'plus', class: 'h-4 w-4' }) }}
            {{ action.label }}
        </a>
    {% endif %}
</div>
