{#
  Pulsante per un'operazione distruttiva, con conferma in linea.

  Il pannello e usato da persone non tecniche: un clic distratto non deve poter
  eliminare un album di trecento fotografie. La conferma spiega cosa succede,
  cosa che un window.confirm del browser non permette di fare.
#}
<form action="{{ action }}" method="post" x-data="confirmAction" class="inline-flex">
    {{ csrf_field()|raw }}

    <button type="button" @click="ask" x-show="isIdle"
            class="{{ buttonClass|default('btn-pericolo btn-piccolo') }}">
        {{ include('components/icon.twig', { name: icon|default('trash'), class: 'h-4 w-4' }) }}
        {{ label|default('Elimina') }}
    </button>

    <span x-show="isConfirming" x-cloak class="inline-flex items-center gap-2">
        <span class="text-sm font-semibold text-rosso-800">{{ question|default('Confermi?') }}</span>
        <button type="submit" class="btn-pericolo btn-piccolo">Si, {{ (label|default('elimina'))|lower }}</button>
        <button type="button" @click="cancel" class="btn-fantasma btn-piccolo">Annulla</button>
    </span>
</form>
