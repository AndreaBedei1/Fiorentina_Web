<article class="group relative flex flex-col overflow-hidden rounded-card bg-white shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lift motion-reduce:hover:transform-none">
    <div class="relative aspect-square overflow-hidden bg-sabbia-100">
        {{ include('components/responsive-image.twig', {
            key: product.primaryImage ? product.primaryImage.storageKey : null,
            collection: 'products',
            alt: product.primaryImage ? product.primaryImage.alt(product.name) : product.name,
            class: 'h-full w-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:transform-none',
            sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'
        }) }}

        {% if product.hasDiscount %}
            <span class="absolute left-3 top-3 rounded-md bg-rosso-600 px-2.5 py-1 text-2xs font-bold text-white">
                -{{ product.discountPercentage }}%
            </span>
        {% endif %}

        {% if not product.isOrderable %}
            <div class="absolute inset-0 flex items-center justify-center bg-white/80">
                <span class="rounded-md bg-sabbia-800 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-white">
                    {{ product.availabilityLabel }}
                </span>
            </div>
        {% endif %}
    </div>

    <div class="flex flex-1 flex-col p-4">
        {% if product.categoryName %}
            <p class="text-2xs font-bold uppercase tracking-[0.14em] text-sabbia-500">{{ product.categoryName }}</p>
        {% endif %}

        <h3 class="mt-1 font-display text-base font-bold leading-snug text-viola-900">
            <a href="{{ route('shop.show', { slug: product.slug }) }}"
               class="rounded transition group-hover:text-viola-700 focus-ring after:absolute after:inset-0 after:content-['']">
                {{ product.name }}
            </a>
        </h3>

        <div class="mt-auto flex items-baseline gap-2 pt-3">
            {% if product.hasPriceRange %}
                <span class="text-sm text-sabbia-600">da</span>
            {% endif %}
            <span class="font-display text-lg font-extrabold text-viola-900">{{ product.priceFrom|euro }}</span>
            {% if product.hasDiscount %}
                <span class="text-sm text-sabbia-500 line-through">{{ product.compareAtPrice|euro }}</span>
            {% endif %}
        </div>
    </div>
</article>
