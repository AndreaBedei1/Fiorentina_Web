{#
  Pagina di errore.

  Nessun dettaglio tecnico: il visitatore riceve una spiegazione comprensibile
  e almeno una via d'uscita. Lo stack trace resta nei log del server.
#}
{% extends 'layouts/base.twig' %}

{% block page_title %}Qualcosa è andato storto - {{ app_name }}{% endblock %}

{% block body_class %}bg-viola-950 text-white antialiased{% endblock %}

{% block body %}
    <main id="contenuto" class="relative isolate flex min-h-screen items-center justify-center overflow-hidden px-4 py-16">

        <div class="absolute inset-0 -z-10 opacity-25" aria-hidden="true">
            <div class="absolute -left-32 top-10 h-96 w-96 rounded-full bg-viola-500 blur-3xl"></div>
            <div class="absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-rosso-600 blur-3xl"></div>
        </div>

        <div class="w-full max-w-xl text-center">
            <a href="/" class="mx-auto mb-8 block w-fit rounded-full focus-ring-light">
                <img src="/assets/logo.png" alt="Torna alla home di {{ setting('site_group_name', app_name) }}"
                     width="64" height="64" class="h-16 w-16">
            </a>

            <p class="font-display text-display-xl font-extrabold leading-none text-white/15" aria-hidden="true">500</p>

            <h1 class="-mt-6 font-display text-display-sm font-extrabold uppercase text-white sm:-mt-8">
                Qualcosa è andato storto
            </h1>

            <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-viola-200">
                {{ message|default('Si e verificato un errore imprevisto. E stato registrato e lo stiamo esaminando.') }}
            </p>

            

            <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="{{ isAdminArea|default(false) ? '/admin' : '/' }}"
                   class="inline-flex items-center justify-center gap-2 rounded-lg bg-rosso-600 px-6 py-3.5 text-base font-bold text-white transition hover:bg-rosso-700 focus-ring-light">
                    Torna alla home
                </a>
                <a href="{{ route('contact.show') }}"
                   class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white/25 px-6 py-3.5 text-base font-bold text-white transition hover:border-white/50 hover:bg-white/5 focus-ring-light">
                    Scrivici
                </a>
            </div>
        </div>
    </main>
{% endblock %}
