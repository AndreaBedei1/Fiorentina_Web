{#
  Scheletro HTML condiviso da sito pubblico e area riservata.

  Qui vivono i metadati: title, description, canonical, OpenGraph e dati
  strutturati si scrivono una volta sola e valgono per ogni pagina. I
  controller passano un oggetto SeoMeta, cosi nessun template deve ricordarsi
  di aggiungere un tag.
#}
<!doctype html>
<html lang="it" class="scroll-smooth motion-reduce:scroll-auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#41215f">

    <title>{{ seo is defined and seo ? seo.fullTitle(setting('site_group_name', app_name)) : app_name }}</title>

    {% if seo is defined and seo and seo.description %}
        <meta name="description" content="{{ seo.description }}">
    {% endif %}

    {% if seo is defined and seo and seo.isNoindex %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        <meta name="robots" content="index, follow, max-image-preview:large">
    {% endif %}

    {% if seo is defined and seo and seo.canonical %}
        <link rel="canonical" href="{{ seo.canonical }}">
    {% endif %}

    {# --- OpenGraph: come appare il sito quando viene condiviso --- #}
    <meta property="og:site_name" content="{{ setting('site_group_name', app_name) }}">
    <meta property="og:locale" content="it_IT">
    <meta property="og:type" content="{{ seo is defined and seo ? seo.type : 'website' }}">
    <meta property="og:title" content="{{ seo is defined and seo ? seo.title : app_name }}">
    {% if seo is defined and seo and seo.description %}
        <meta property="og:description" content="{{ seo.description }}">
    {% endif %}
    {% if seo is defined and seo and seo.canonical %}
        <meta property="og:url" content="{{ seo.canonical }}">
    {% endif %}
    {% if seo is defined and seo and seo.imageUrl %}
        <meta property="og:image" content="{{ seo.imageUrl }}">
        <meta name="twitter:card" content="summary_large_image">
    {% else %}
        <meta name="twitter:card" content="summary">
    {% endif %}

    {# --- Icone --- #}
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml">
    <link rel="alternate icon" href="/favicon/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
    <link rel="manifest" href="/favicon/site.webmanifest">

    {# --- Dati strutturati --- #}
    {% if seo is defined and seo %}
        {% set structured = seo.structuredDataJson %}
        {% if structured %}
            <script type="application/ld+json">{{ structured|raw }}</script>
        {% endif %}

        {% set breadcrumbJson = seo.breadcrumbJson(app_url) %}
        {% if breadcrumbJson %}
            <script type="application/ld+json">{{ breadcrumbJson|raw }}</script>
        {% endif %}
    {% endif %}

    {{ vite(vite_entry|default('resources/js/site.ts')) }}

    {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}bg-sabbia-50 text-sabbia-900 antialiased{% endblock %}">
    {#
      Collegamento di salto: primo elemento focalizzabile della pagina.
      Chi naviga da tastiera puo arrivare al contenuto senza attraversare
      tutto il menu a ogni pagina.
    #}
    <a href="#contenuto"
       class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100]
              focus:rounded-lg focus:bg-viola-800 focus:px-4 focus:py-3 focus:text-white
              focus:outline-none focus:ring-4 focus:ring-rosso-400">
        Vai al contenuto principale
    </a>

    {% block body %}{% endblock %}

    {% block scripts %}{% endblock %}
</body>
</html>
