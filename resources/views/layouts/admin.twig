{#
  Struttura del pannello: barra laterale a sinistra, contenuto a destra.

  Su schermi stretti la barra diventa un pannello a scomparsa: le tabelle
  amministrative hanno bisogno di tutta la larghezza disponibile, e una barra
  fissa su telefono renderebbe il pannello inutilizzabile.
#}
{% extends 'layouts/base.twig' %}

{% set vite_entry = 'resources/js/admin.ts' %}

{% block body_class %}bg-sabbia-100 text-sabbia-900 antialiased{% endblock %}

{% block body %}
    <div x-data="adminShell" class="min-h-screen lg:flex">

        {# --- Barra laterale --- #}
        <div x-show="isOpen" x-cloak @click="closeSidebar"
             class="fixed inset-0 z-40 bg-viola-950/60 lg:hidden" aria-hidden="true"></div>

        <aside id="menu-admin"
               class="pannello-laterale flex flex-col"
               :data-open="openAttr"
               data-open="false"
               @keydown.escape.window="closeSidebar">

            <div class="flex h-16 items-center justify-between gap-2 border-b border-white/10 px-4">
                <a href="{{ route('admin.home') }}" class="flex items-center gap-2.5 rounded-lg focus-ring-light">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 ring-1 ring-white/20">
                        <img src="/assets/logo.svg" alt="" width="22" height="22" class="h-5.5 w-5.5" aria-hidden="true">
                    </span>
                    <span class="flex flex-col leading-none">
                        <span class="font-display text-sm font-extrabold uppercase tracking-tight text-white">Pannello</span>
                        <span class="mt-0.5 text-2xs text-viola-300">{{ setting('site_group_name', 'Baraonda') }}</span>
                    </span>
                </a>

                <button type="button" @click="closeSidebar"
                        class="flex h-9 w-9 items-center justify-center rounded-lg text-viola-200 hover:bg-white/10 hover:text-white focus-ring-light lg:hidden">
                    <span class="sr-only">Chiudi il menu</span>
                    {{ include('components/icon.twig', { name: 'close', class: 'h-5 w-5' }) }}
                </button>
            </div>

            {% set sections = [
                {
                    label: 'Contenuti',
                    items: [
                        { label: 'Notizie',   url: route('admin.news.index'),     icon: 'news',     permission: 'news.manage' },
                        { label: 'Eventi',    url: route('admin.events.index'),   icon: 'calendar', permission: 'events.manage' },
                        { label: 'Calendario partite', url: route('admin.calendar.index'), icon: 'ball', permission: 'calendar.manage' }
                    ]
                },
                {
                    label: 'Galleria',
                    items: [
                        { label: 'Album e foto',    url: route('admin.gallery.index'), icon: 'image',     permission: 'gallery.manage' },
                        { label: 'Contenuti social', url: route('admin.social.index'), icon: 'instagram', permission: 'social.manage' }
                    ]
                },
                {
                    label: 'Merchandising',
                    items: [
                        { label: 'Prodotti', url: route('admin.products.index'), icon: 'shirt', permission: 'products.manage' },
                        { label: 'Ordini',   url: route('admin.orders.index'),   icon: 'cart',  permission: 'orders.manage' }
                    ]
                },
                {
                    label: 'Sito',
                    items: [
                        { label: 'Pagine',        url: route('admin.pages.index'),        icon: 'file',  permission: 'pages.manage' },
                        { label: 'Organizzazione',url: route('admin.organization.index'), icon: 'users', permission: 'organization.manage' }
                    ]
                },
                {
                    label: 'Amministrazione',
                    items: [
                        { label: 'Amministratori',   url: route('admin.users.index'),    icon: 'shield',   permission: 'admins.manage' },
                        { label: 'Impostazioni',     url: route('admin.settings.index'), icon: 'settings', permission: 'settings.manage' },
                        { label: 'Registro attività',url: route('admin.audit.index'),    icon: 'file',     permission: 'audit.view' }
                    ]
                }
            ] %}

            <nav class="px-3 py-4" aria-label="Menu del pannello">
                {% for section in sections %}
                    {% set visible = [] %}
                    {% for item in section.items %}
                        {% if can(item.permission) %}{% set visible = visible|merge([item]) %}{% endif %}
                    {% endfor %}

                    {% if visible is not empty %}
                        <div class="{{ loop.first ? '' : 'mt-5' }}">
                            {% if section.label %}
                                <p class="px-3 pb-1.5 text-2xs font-bold uppercase tracking-[0.14em] text-viola-400">{{ section.label }}</p>
                            {% endif %}

                            <ul class="space-y-0.5" role="list">
                                {% for item in visible %}
                                    {% set active = is_active(item.url, item.exact|default(false)) %}
                                    <li>
                                        <a href="{{ item.url }}"
                                           @click="closeSidebar"
                                           class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-semibold transition focus-ring-light
                                                  {{ active ? 'bg-white/12 text-white' : 'text-viola-100 hover:bg-white/8 hover:text-white' }}"
                                           {{ active ? 'aria-current="page"' : '' }}>
                                            <span class="{{ active ? 'text-rosso-400' : 'text-viola-400' }}">
                                                {{ include('components/icon.twig', { name: item.icon, class: 'h-4.5 w-4.5' }) }}
                                            </span>
                                            {{ item.label }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                {% endfor %}
            </nav>

            {# --- Utente --- #}
            {% set me = current_user() %}
            {% if me %}
                <div class="mt-auto border-t border-white/10 p-3">
                    <a href="{{ route('admin.profile') }}"
                       class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 transition hover:bg-white/8 focus-ring-light">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-viola-700 text-xs font-bold text-white">
                            {{ me.name|iniziali }}
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-semibold text-white">{{ me.name }}</span>
                            <span class="block truncate text-2xs text-viola-300">{{ me.roleLabel }}</span>
                        </span>
                    </a>

                    <form action="{{ route('admin.logout') }}" method="post" class="mt-1">
                        {{ csrf_field()|raw }}
                        <button type="submit"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-semibold text-viola-200 transition hover:bg-white/8 hover:text-white focus-ring-light">
                            {{ include('components/icon.twig', { name: 'logout', class: 'h-4.5 w-4.5 text-viola-400' }) }}
                            Esci
                        </button>
                    </form>
                </div>
            {% endif %}
        </aside>

        {# --- Contenuto --- #}
        <div class="flex min-w-0 flex-1 flex-col">

            <header class="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-sabbia-200 bg-white px-4 sm:px-6 lg:hidden">
                <button type="button" @click="toggleSidebar"
                        :aria-expanded="expanded"
                        aria-expanded="false"
                        aria-controls="menu-admin"
                        class="flex h-10 w-10 items-center justify-center rounded-lg text-viola-900 transition hover:bg-sabbia-100 focus-ring">
                    <span class="sr-only">Apri il menu del pannello</span>
                    {{ include('components/icon.twig', { name: 'menu', class: 'h-6 w-6' }) }}
                </button>

                <span class="font-display text-base font-bold text-viola-900">Pannello</span>

                <a href="{{ route('home') }}" target="_blank" rel="noopener"
                   class="ml-auto flex h-10 w-10 items-center justify-center rounded-lg text-sabbia-600 transition hover:bg-sabbia-100 hover:text-viola-900 focus-ring">
                    <span class="sr-only">Apri il sito pubblico (nuova scheda)</span>
                    {{ include('components/icon.twig', { name: 'external', class: 'h-5 w-5' }) }}
                </a>
            </header>

            <main id="contenuto" class="flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
                {{ include('components/alerts.twig') }}
                {% block content %}{% endblock %}
            </main>

            <footer class="border-t border-sabbia-200 px-4 py-4 text-xs text-sabbia-500 sm:px-6 lg:px-8">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <p>{{ setting('site_group_name', 'Baraonda Fiorentina') }} - pannello di gestione</p>
                    <a href="{{ route('home') }}" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1.5 font-semibold text-viola-800 hover:text-viola-950 focus-ring rounded">
                        Vedi il sito pubblico
                        {{ include('components/icon.twig', { name: 'external', class: 'h-3.5 w-3.5' }) }}
                    </a>
                </div>
            </footer>
        </div>
    </div>
{% endblock %}
