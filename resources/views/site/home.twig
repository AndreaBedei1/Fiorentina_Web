{% extends 'layouts/site.twig' %}

{% block content %}

    {# =====================================================================
       APERTURA
       Chi arriva sul sito vuole sapere due cose: chi siamo e cosa succede
       adesso. Stanno entrambe qui, senza dover scorrere: a sinistra il gruppo,
       a destra la prossima partita e i prossimi appuntamenti.

       Notizie, galleria e merchandising non compaiono più in questa pagina:
       hanno la loro voce nel menu, e ripeterle qui allungava la homepage
       senza aggiungere niente.
       ===================================================================== #}
    <section class="relative isolate overflow-hidden bg-viola-950" aria-labelledby="hero-title">

        <div class="absolute inset-0 -z-10" aria-hidden="true">
            <img src="/assets/hero.svg"
                 alt=""
                 class="h-full w-full object-cover object-center opacity-40"
                 fetchpriority="high"
                 decoding="sync">
            <div class="absolute inset-0 bg-gradient-to-b from-viola-950/70 via-viola-950/85 to-viola-950"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-viola-950/90 via-viola-950/40 to-transparent"></div>
        </div>

        {# Il giglio di Firenze, grande e appena accennato: decorazione, non
           informazione. Sta a sinistra, dietro al titolo, dove il fondo resta
           scuro: a destra finirebbe sotto le card e non si vedrebbe.
           Sconfina oltre il bordo di proposito, come un timbro. #}
        <div class="pointer-events-none absolute -left-20 top-6 text-white opacity-[0.07] sm:-left-14 lg:top-10 lg:opacity-[0.09]" aria-hidden="true">
            {{ include('components/giglio.twig', { class: 'h-[20rem] w-auto sm:h-[26rem] lg:h-[32rem]' }) }}
        </div>

        {# Lo stemma viola dall'altra parte, ancora piu in sordina: qui sopra
           passano le card, e un fondo troppo carico le renderebbe illeggibili. #}
        {{ include('components/stemma-fiorentina.twig', {
            wrapper: '-right-24 -bottom-16 hidden lg:block',
            class: 'h-[26rem] w-auto',
            opacita: 'opacity-[0.05]'
        }) }}

        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
            <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-10">

                {# --- Il gruppo --------------------------------------------- #}
                <div class="lg:col-span-6 xl:col-span-7">
                    <p class="flex items-center gap-3 text-2xs font-bold uppercase tracking-[0.22em] text-rosso-400 sm:text-xs">
                        <span class="h-px w-8 bg-rosso-500" aria-hidden="true"></span>
                        Dal {{ setting('site_founded_year', 2015) }} sugli spalti
                    </p>

                    <h1 id="hero-title" class="mt-5 font-display text-display-lg font-extrabold uppercase leading-none text-white">
                        {{ setting('home_hero_title', 'Siamo la Baraonda') }}
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-viola-100 sm:text-xl">
                        {{ setting('home_hero_subtitle') }}
                    </p>

                    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                        <a href="{{ route('page.join') }}"
                           class="inline-flex items-center justify-center gap-2 rounded-lg bg-rosso-600 px-7 py-4 text-base font-bold text-white shadow-lg transition hover:bg-rosso-700 focus-ring-light">
                            {{ setting('home_cta_label', 'Diventa socio') }}
                            {{ include('components/icon.twig', { name: 'arrow-right', class: 'h-5 w-5' }) }}
                        </a>

                        <a href="{{ route('page.about') }}"
                           class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white/25 bg-white/5 px-7 py-4 text-base font-bold text-white backdrop-blur-sm transition hover:border-white/50 hover:bg-white/10 focus-ring-light">
                            Scopri il gruppo
                        </a>

                        <a href="{{ route('contact.show') }}"
                           class="inline-flex items-center justify-center gap-2 rounded-lg px-7 py-4 text-base font-semibold text-viola-100 underline underline-offset-4 transition hover:text-white focus-ring-light">
                            Contattaci
                        </a>
                    </div>
                </div>

                {# --- Cosa succede adesso ----------------------------------- #}
                {% if nextMatch or upcomingEvents is not empty %}
                    <div class="lg:col-span-6 xl:col-span-5">
                        <h2 id="appuntamenti-title" class="sr-only">Prossimi appuntamenti</h2>

                        <div class="space-y-8">

                            {% if nextMatch %}
                                <div>
                                    <p class="mb-3 flex items-center gap-2 text-2xs font-bold uppercase tracking-[0.16em] text-rosso-400">
                                        <span class="h-px w-6 bg-rosso-500" aria-hidden="true"></span>
                                        Prossima partita
                                    </p>

                                    {# Un anello chiaro stacca la card dallo sfondo scuro: senza,
                                       il gradiente viola della card si confonderebbe con la sezione. #}
                                    <div class="rounded-panel ring-1 ring-white/15">
                                        {{ include('components/match-card.twig', { match: nextMatch, showTeamLogos: showTeamLogos }) }}
                                    </div>

                                    <a href="{{ route('events.index') }}#calendario"
                                       class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-viola-100 transition hover:text-white focus-ring-light rounded">
                                        Vedi tutto il calendario
                                        {{ include('components/icon.twig', { name: 'arrow-right', class: 'h-4 w-4' }) }}
                                    </a>
                                </div>
                            {% endif %}

                            {% if upcomingEvents is not empty %}
                                <div>
                                    <p class="mb-3 flex items-center gap-2 text-2xs font-bold uppercase tracking-[0.16em] text-rosso-400">
                                        <span class="h-px w-6 bg-rosso-500" aria-hidden="true"></span>
                                        Prossimo appuntamento
                                    </p>

                                    <ul class="space-y-3" role="list">
                                        {% for event in upcomingEvents %}
                                            <li>{{ include('components/event-card.twig', { event: event }) }}</li>
                                        {% endfor %}
                                    </ul>

                                    <a href="{{ route('events.index') }}"
                                       class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-viola-100 transition hover:text-white focus-ring-light rounded">
                                        Tutti gli appuntamenti
                                        {{ include('components/icon.twig', { name: 'arrow-right', class: 'h-4 w-4' }) }}
                                    </a>
                                </div>
                            {% endif %}

                        </div>
                    </div>
                {% endif %}

            </div>
        </div>
    </section>


    {# =====================================================================
       SOCIAL
       ===================================================================== #}
    {% if socialPosts is not empty %}
        <section class="bg-sabbia-50 py-section" aria-labelledby="social-title">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                {{ include('components/section-header.twig', {
                    eyebrow: 'Seguici',
                    title: 'Sui social',
                    subtitle: 'Gli ultimi contenuti pubblicati sui nostri profili.'
                }) }}

                {# Le colonne seguono il numero di contenuti: con due video, una
                   griglia da sei lascerebbe due terzi di riga vuoti e sembrerebbe
                   che manchi qualcosa. Le classi sono scritte per esteso perche
                   Tailwind le cerca nel sorgente e non le costruisce a runtime. #}
                {% set colonneDesktop = {
                    1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3',
                    4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5'
                } %}
                {% set larghezza = {
                    1: 'max-w-xs', 2: 'max-w-xl', 3: 'max-w-3xl',
                    4: 'max-w-4xl', 5: 'max-w-5xl'
                } %}

                <ul class="mx-auto grid grid-cols-2 gap-3 sm:gap-4
                           {{ larghezza[socialPosts|length]|default('max-w-7xl') }}
                           {{ socialPosts|length >= 3 ? 'sm:grid-cols-3' : '' }}
                           {{ colonneDesktop[socialPosts|length]|default('lg:grid-cols-6') }}" role="list">
                    {% for post in socialPosts %}
                        <li>{{ include('components/social-card.twig', { post: post }) }}</li>
                    {% endfor %}
                </ul>

                {% set links = social_links() %}
                {% if links %}
                    <div class="mt-8 flex flex-wrap justify-center gap-3">
                        {% for link in links %}
                            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-2 rounded-lg border border-sabbia-300 bg-white px-4 py-2.5 text-sm font-semibold text-viola-800 transition hover:border-viola-400 hover:bg-viola-50 focus-ring">
                                {{ include('components/icon.twig', { name: link.name, class: 'h-4 w-4' }) }}
                                {{ link.label }}
                                <span class="sr-only">(si apre in una nuova scheda)</span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}


    {# =====================================================================
       INVITO ALL'ISCRIZIONE
       Obiettivo dichiarato del sito: aumentare gli iscritti.
       ===================================================================== #}
    <section class="relative isolate overflow-hidden bg-viola-900" aria-labelledby="cta-title">
        <div class="absolute inset-0 -z-10 opacity-20" aria-hidden="true">
            <div class="absolute -left-24 top-0 h-72 w-72 rounded-full bg-rosso-600 blur-3xl"></div>
            <div class="absolute -right-16 bottom-0 h-72 w-72 rounded-full bg-viola-400 blur-3xl"></div>
        </div>

        <div class="pointer-events-none absolute -left-16 top-1/2 hidden -translate-y-1/2 text-white opacity-[0.08] sm:block" aria-hidden="true">
            {{ include('components/giglio.twig', { class: 'h-64 w-auto' }) }}
        </div>

        {{ include('components/stemma-fiorentina.twig', {
            wrapper: '-right-16 top-1/2 -translate-y-1/2 hidden sm:block',
            class: 'h-64 w-auto',
            opacita: 'opacity-[0.07]'
        }) }}

        <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
            <h2 id="cta-title" class="font-display text-display-md font-extrabold uppercase leading-tight text-white">
                Entra nella Baraonda
            </h2>

            <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-viola-100">
                Trasferte organizzate, cene sociali, coreografie, amicizie che durano.
                Iscriversi è semplice: bastano pochi minuti.
            </p>

            <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="{{ route('page.join') }}"
                   class="inline-flex items-center justify-center gap-2 rounded-lg bg-rosso-600 px-8 py-4 text-base font-bold text-white shadow-lg transition hover:bg-rosso-700 focus-ring-light">
                    Come iscriversi
                    {{ include('components/icon.twig', { name: 'arrow-right', class: 'h-5 w-5' }) }}
                </a>

                <a href="{{ route('contact.show') }}"
                   class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white/25 px-8 py-4 text-base font-bold text-white transition hover:border-white/50 hover:bg-white/5 focus-ring-light">
                    Fai una domanda
                </a>
            </div>
        </div>
    </section>

{% endblock %}
