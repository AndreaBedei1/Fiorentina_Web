{% extends 'layouts/site.twig' %}

{% block content %}
    <article class="pb-section">

        {# --- Testata --- #}
        <header class="relative isolate overflow-hidden bg-viola-900">
            {% if article.imageKey %}
                <div class="absolute inset-0 -z-10" aria-hidden="true">
                    {{ include('components/responsive-image.twig', {
                        key: article.imageKey,
                        collection: 'news',
                        alt: '',
                        eager: true,
                        class: 'h-full w-full object-cover opacity-30',
                        sizes: '100vw'
                    }) }}
                    <div class="absolute inset-0 bg-gradient-to-t from-viola-900 via-viola-900/85 to-viola-900/60"></div>
                </div>
            {% endif %}

            <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-2xs font-bold uppercase tracking-[0.16em] text-rosso-400">
                    <time datetime="{{ article.publishedAt|iso }}">{{ article.publishedAt|data }}</time>
                </p>

                <h1 class="mt-4 font-display text-display-md font-extrabold leading-tight text-white">{{ article.title }}</h1>

                {% if article.excerpt %}
                    <p class="mt-5 text-lg leading-relaxed text-viola-100">{{ article.excerpt }}</p>
                {% endif %}
            </div>
        </header>

        {# --- Immagine principale --- #}
        {% if article.imageKey %}
            <div class="mx-auto -mt-8 max-w-4xl px-4 sm:px-6">
                <div class="overflow-hidden rounded-panel shadow-panel">
                    {{ include('components/responsive-image.twig', {
                        key: article.imageKey,
                        collection: 'news',
                        alt: article.imageAlt,
                        eager: true,
                        class: 'w-full object-cover',
                        sizes: '(min-width: 1024px) 56rem, 100vw'
                    }) }}
                </div>
            </div>
        {% endif %}

        {# --- Corpo --- #}
        <div class="mx-auto mt-10 max-w-3xl px-4 sm:px-6">
            {% if article.content %}
                {# Contenuto già sanificato in scrittura da HtmlSanitizer. #}
                <div class="contenuto">{{ article.content|raw }}</div>
            {% endif %}

            <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-sabbia-200 pt-6">
                <a href="{{ route('news.index') }}" class="btn-secondario">
                    {{ include('components/icon.twig', { name: 'arrow-left', class: 'h-4 w-4' }) }}
                    Tutte le notizie
                </a>

                {% if article.updatedAt %}
                    <p class="text-sm text-sabbia-500">
                        Aggiornata il <time datetime="{{ article.updatedAt|iso }}">{{ article.updatedAt|data_numerica }}</time>
                    </p>
                {% endif %}
            </div>
        </div>
    </article>
{% endblock %}
