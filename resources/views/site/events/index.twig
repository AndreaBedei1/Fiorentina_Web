{% extends 'layouts/site.twig' %}

{% block content %}
    {{ include('components/page-hero.twig', {
        eyebrow: 'Appuntamenti',
        title: showPast ? 'Eventi passati' : 'Eventi e trasferte',
        subtitle: 'Trasferte organizzate, riunioni, cene sociali e raduni del gruppo.'
    }) }}

    <section class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">

        {# --- Filtri --- #}
        <div class="mb-8 flex flex-col gap-4 border-b border-sabbia-200 pb-6 lg:flex-row lg:items-center lg:justify-between">
            <nav class="flex flex-wrap gap-2" aria-label="Filtra per categoria">
                <a href="{{ route('events.index') }}{{ showPast ? '?passati=1' : '' }}"
                   class="rounded-lg px-3.5 py-2 text-sm font-semibold transition focus-ring
                          {{ activeCategory is null ? 'bg-viola-800 text-white' : 'bg-white text-viola-800 ring-1 ring-sabbia-300 hover:bg-viola-50' }}"
                   {{ activeCategory is null ? 'aria-current="true"' : '' }}>
                    Tutte
                </a>

                {% for category in categories %}
                    <a href="{{ route('events.index') }}?categoria={{ category.slug }}{{ showPast ? '&passati=1' : '' }}"
                       class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold transition focus-ring
                              {{ activeCategory == category.slug ? 'bg-viola-800 text-white' : 'bg-white text-viola-800 ring-1 ring-sabbia-300 hover:bg-viola-50' }}"
                       {{ activeCategory == category.slug ? 'aria-current="true"' : '' }}>
                        {{ include('components/icon.twig', { name: category.icon, class: 'h-4 w-4' }) }}
                        {{ category.name }}
                    </a>
                {% endfor %}
            </nav>

            <div class="flex gap-2" role="group" aria-label="Periodo">
                <a href="{{ route('events.index') }}{{ activeCategory ? '?categoria=' ~ activeCategory : '' }}"
                   class="rounded-lg px-3.5 py-2 text-sm font-semibold transition focus-ring
                          {{ not showPast ? 'bg-rosso-600 text-white' : 'bg-white text-viola-800 ring-1 ring-sabbia-300 hover:bg-viola-50' }}"
                   {{ not showPast ? 'aria-current="true"' : '' }}>
                    In programma
                </a>
                <a href="{{ route('events.index') }}?passati=1{{ activeCategory ? '&categoria=' ~ activeCategory : '' }}"
                   class="rounded-lg px-3.5 py-2 text-sm font-semibold transition focus-ring
                          {{ showPast ? 'bg-rosso-600 text-white' : 'bg-white text-viola-800 ring-1 ring-sabbia-300 hover:bg-viola-50' }}"
                   {{ showPast ? 'aria-current="true"' : '' }}>
                    Gia svolti
                </a>
            </div>
        </div>

        {% if paginator.isEmpty %}
            {{ include('components/empty-state.twig', {
                icon: 'calendar',
                title: showPast ? 'Nessun evento passato' : 'Nessun evento in programma',
                message: showPast
                    ? 'Non ci sono eventi conclusi da mostrare con questi filtri.'
                    : 'Al momento non ci sono appuntamenti in calendario. Torna a trovarci presto.',
                action: { url: '#calendario', label: 'Vai al calendario' }
            }) }}
        {% else %}
            <ul class="grid gap-4 lg:grid-cols-2" role="list">
                {% for event in paginator.items %}
                    <li data-reveal style="--reveal-delay: {{ (loop.index0 % 2) * 70 }}ms">
                        {{ include('components/event-card.twig', { event: event, heading: 'h2' }) }}
                    </li>
                {% endfor %}
            </ul>

            {{ include('components/pagination.twig', { paginator: paginator }) }}
        {% endif %}
    </section>

    {# =====================================================================
       CALENDARIO
       Chiude la pagina: sopra c'e cosa organizza il gruppo, qui sotto tutto
       il mese, partite comprese.
       ===================================================================== #}
    <section id="calendario" class="border-t border-sabbia-200 bg-white/60 scroll-mt-24" aria-label="Calendario del mese">
        <div class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">
            {{ include('components/section-header.twig', {
                eyebrow: 'Mese per mese',
                title: 'Calendario',
                subtitle: 'Le partite della Fiorentina e gli appuntamenti della Baraonda, in un unico posto.'
            }) }}

            {#
              Le frecce dei mesi conservano i filtri dell'elenco qui sopra:
              cambiare mese nel calendario non deve azzerare la categoria che
              il lettore aveva scelto.
            #}
            {% set filtri = [] %}
            {% if activeCategory %}{% set filtri = filtri|merge(['categoria=' ~ activeCategory]) %}{% endif %}
            {% if showPast %}{% set filtri = filtri|merge(['passati=1']) %}{% endif %}

            {{ include('components/calendario-mensile.twig', {
                base: route('events.index') ~ (filtri is empty ? '' : '?' ~ filtri|join('&'))
            }) }}
        </div>
    </section>
{% endblock %}
