{% extends 'layouts/site.twig' %}

{% block content %}
    {{ include('components/page-hero.twig', {
        eyebrow: 'Il gruppo',
        title: page.title,
        subtitle: page.subtitle
    }) }}

    <div class="mx-auto max-w-6xl px-4 py-section sm:px-6 lg:px-8">

        {% if page.heroImageKey %}
            <figure class="-mt-16 mb-10 overflow-hidden rounded-panel shadow-panel">
                {{ include('components/responsive-image.twig', {
                    key: page.heroImageKey, collection: 'pages',
                    alt: page.heroImageAlt ?? page.title, eager: true,
                    class: 'w-full object-cover', sizes: '(min-width: 1024px) 72rem, 100vw'
                }) }}
            </figure>
        {% endif %}

        {#
          Numeri e tappe sono dati da consultare, non da leggere in sequenza:
          su schermo largo stanno in una colonna a fianco, dove non spezzano
          il filo del racconto. Sotto i 1024 px tornano in fila sotto il testo,
          perche affiancarli su schermo stretto li renderebbe illeggibili.
        #}
        {# Il filtro di Twig conserva le chiavi originali: qui servono numerate
           da zero, perche le due tavole vengono collocate una per riga. #}
        {% set aFianco = [] %}
        {% for blocco in page.visibleBlocks %}
            {% if blocco.type in ['stats', 'timeline'] %}
                {% set aFianco = aFianco|merge([blocco]) %}
            {% endif %}
        {% endfor %}

        {% set nelTesto = page.visibleBlocks|filter(b => b.type not in ['stats', 'timeline']) %}

        {#
          Due righe, due colonne. Ogni riga allinea in alto quello che contiene,
          quindi la prima tavola parte all'altezza della presentazione e la
          seconda all'altezza dell'ultima sezione del testo. Senza griglia le
          due colonne scorrerebbero indipendenti e i titoli non si
          incontrerebbero mai.

          Sotto i 1024 px la griglia non si applica e tutto torna in fila.
        #}
        <div class="lg:grid lg:grid-cols-12 lg:gap-x-12 lg:gap-y-12">

            {# --- Riga 1: presentazione e prime sezioni | prima tavola --- #}
            <div class="lg:col-span-7 lg:row-start-1">
                {% if page.intro %}
                    <p class="text-xl leading-relaxed text-viola-900">{{ page.intro }}</p>
                {% endif %}

                {% if testoIniziale %}
                    <div class="contenuto mt-8">{{ testoIniziale|raw }}</div>
                {% endif %}
            </div>

            {% if aFianco[0] is defined %}
                <aside class="mt-12 lg:col-span-5 lg:row-start-1 lg:mt-0" aria-label="{{ aFianco[0].title|default('Approfondimento') }}">
                    {{ include('components/page-blocks.twig', { blocks: [aFianco[0]], stretto: true }) }}
                </aside>
            {% endif %}

            {# --- Riga 2: ultima sezione e valori | seconda tavola --- #}
            <div class="lg:col-span-7 lg:row-start-2">
                {% if testoFinale %}
                    {# Su schermo stretto serve stacco dalla sezione precedente; su
                       schermo largo lo spazio fra le righe lo mette la griglia. #}
                    <div class="contenuto {{ testoIniziale ? 'mt-10 lg:mt-0' : 'mt-8 lg:mt-0' }}">{{ testoFinale|raw }}</div>
                {% endif %}

                {{ include('components/page-blocks.twig', { blocks: nelTesto }) }}
            </div>

            {% if aFianco[1] is defined %}
                <aside class="mt-12 lg:col-span-5 lg:row-start-2 lg:mt-0" aria-label="{{ aFianco[1].title|default('Approfondimento') }}">
                    {{ include('components/page-blocks.twig', { blocks: [aFianco[1]], stretto: true }) }}
                </aside>
            {% endif %}

            {# Eventuali tavole oltre le due previste restano in coda, senza
               allineamenti forzati: la pagina non deve rompersi se qualcuno ne
               aggiunge una terza dal pannello. #}
            {% if aFianco|length > 2 %}
                <aside class="mt-12 lg:col-span-5 lg:col-start-8 lg:row-start-3" aria-label="Altri dati">
                    {{ include('components/page-blocks.twig', { blocks: aFianco|slice(2), stretto: true }) }}
                </aside>
            {% endif %}

        </div>

        {# --- Organigramma --- #}
        {% if members is not empty %}
            <section class="mt-section" aria-labelledby="direttivo-title">
                <h2 id="direttivo-title" class="font-display text-2xl font-bold text-viola-900">Chi guida il gruppo</h2>

                {# Fotografia, nome e ruolo: chi arriva qui vuole sapere a chi
                   rivolgersi, non leggere una biografia. #}
                <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
                    {% for member in members %}
                        <li class="rounded-card bg-white p-5 text-center shadow-card">
                            {% if member.hasPhoto %}
                                <span class="mx-auto block h-24 w-24 overflow-hidden rounded-full bg-sabbia-100">
                                    {{ include('components/responsive-image.twig', {
                                        key: member.photoKey, collection: 'members',
                                        alt: 'Fotografia di ' ~ member.fullName, size: 'thumb',
                                        class: 'h-full w-full object-cover', sizes: '96px'
                                    }) }}
                                </span>
                            {% else %}
                                {# Avatar con iniziali: meglio di un riquadro vuoto o di una silhouette generica. #}
                                <span class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-viola-100 font-display text-2xl font-extrabold text-viola-700"
                                      aria-hidden="true">
                                    {{ member.initials }}
                                </span>
                            {% endif %}

                            <p class="mt-4 font-display text-base font-bold text-viola-900">{{ member.fullName }}</p>

                            {% if member.displayRole %}
                                <p class="mt-0.5 text-2xs font-bold uppercase tracking-[0.12em] text-rosso-700">{{ member.displayRole }}</p>
                            {% endif %}

                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {# --- Invito finale --- #}
        <section class="mt-section rounded-panel bg-gradient-to-br from-viola-800 to-viola-950 p-8 text-center sm:p-12">
            <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">Ti va di far parte di tutto questo?</h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-viola-100">
                Le iscrizioni sono aperte tutto l'anno. Bastano un documento e pochi minuti in sede.
            </p>
            <a href="{{ route('page.join') }}"
               class="mt-6 inline-flex items-center gap-2 rounded-lg bg-rosso-600 px-7 py-3.5 text-base font-bold text-white transition hover:bg-rosso-700 focus-ring-light">
                Scopri come iscriverti
                {{ include('components/icon.twig', { name: 'arrow-right', class: 'h-5 w-5' }) }}
            </a>
        </section>
    </div>
{% endblock %}
