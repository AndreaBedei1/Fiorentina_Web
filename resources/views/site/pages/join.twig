{% extends 'layouts/site.twig' %}

{% block hero %}
    {{ include('components/page-hero.twig', {
        eyebrow: 'Tesseramento',
        title: page.title,
        subtitle: page.subtitle
    }) }}
{% endblock %}

{% block content %}
    <div class="mx-auto max-w-5xl px-4 py-section sm:px-6 lg:px-8">

        {% if page.intro %}
            <p class="max-w-3xl text-xl leading-relaxed text-viola-900">{{ page.intro }}</p>
        {% endif %}

        {% if page.content %}
            <div class="contenuto mt-8">{{ page.content|raw }}</div>
        {% endif %}

        {{ include('components/page-blocks.twig', { blocks: page.visibleBlocks }) }}

        {# --- Riquadro operativo: quota e contatti, sempre in evidenza --- #}
        <section class="mt-12 grid gap-5 sm:grid-cols-2" aria-labelledby="pratiche-title">
            <h2 id="pratiche-title" class="sr-only">Informazioni pratiche</h2>

            <div class="rounded-panel bg-white p-6 shadow-card">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-rosso-100 text-rosso-700">
                    {{ include('components/icon.twig', { name: 'star', class: 'h-5 w-5' }) }}
                </span>
                <h3 class="mt-4 font-display text-lg font-bold text-viola-900">Quota associativa</h3>
                <p class="mt-2 text-base text-sabbia-700">{{ membershipFee }}</p>
            </div>

            <div class="rounded-panel bg-white p-6 shadow-card">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-viola-100 text-viola-700">
                    {{ include('components/icon.twig', { name: 'mail', class: 'h-5 w-5' }) }}
                </span>
                <h3 class="mt-4 font-display text-lg font-bold text-viola-900">A chi rivolgersi</h3>
                <p class="mt-2 text-base text-sabbia-700">
                    {% if membershipContact matches '/^[^@\s]+@[^@\s]+$/' %}
                        <a href="mailto:{{ membershipContact }}" class="font-semibold text-viola-800 underline underline-offset-2 focus-ring rounded">
                            {{ membershipContact }}
                        </a>
                    {% else %}
                        {{ membershipContact }}
                    {% endif %}
                </p>
                {% if setting('contact_opening_hours') %}
                    <p class="mt-3 whitespace-pre-line text-sm text-sabbia-600">{{ setting('contact_opening_hours') }}</p>
                {% endif %}
            </div>
        </section>

        <section class="mt-12 rounded-panel bg-viola-900 p-8 text-center sm:p-12">
            <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">Hai ancora una domanda?</h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-viola-100">
                Scrivici: rispondiamo a tutti. Oppure passa in sede negli orari di apertura.
            </p>
            <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="{{ route('contact.show') }}"
                   class="inline-flex items-center justify-center gap-2 rounded-lg bg-rosso-600 px-7 py-3.5 text-base font-bold text-white transition hover:bg-rosso-700 focus-ring-light">
                    Scrivici
                </a>
                <a href="{{ route('page.about') }}"
                   class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white/25 px-7 py-3.5 text-base font-bold text-white transition hover:border-white/50 hover:bg-white/5 focus-ring-light">
                    Conosci il gruppo
                </a>
            </div>
        </section>
    </div>
{% endblock %}
