{% extends 'layouts/site.twig' %}

{% block content %}
    {{ include('components/page-hero.twig', {
        eyebrow: 'Ultimo passaggio',
        title: 'Invia il tuo ordine',
        subtitle: 'Lasciaci i tuoi dati: ti ricontattiamo noi per dirti come procedere con il pagamento.'
    }) }}

    <section class="mx-auto max-w-6xl px-4 py-section sm:px-6 lg:px-8">

        {# Dichiarato subito e a chiare lettere: è la cosa che le persone si
           chiedono per prima davanti a un modulo con dei prezzi. #}
        <div class="mb-8 flex items-start gap-3 rounded-card border border-viola-200 bg-viola-50 px-4 py-4 text-sm text-viola-900">
            <span class="mt-0.5 shrink-0 text-viola-600">{{ include('components/icon.twig', { name: 'shield', class: 'h-5 w-5' }) }}</span>
            <div>
                <p class="font-semibold">Nessun pagamento su questo sito</p>
                <p class="mt-1 leading-relaxed">
                    Qui invii l'ordine e basta. Con i dati che lasci ti contattiamo per
                    concordare il pagamento e dirti quanto costa la spedizione.
                    Non inserire mai dati di carte di credito.
                </p>
            </div>
        </div>

        <form action="{{ route('order.store') }}" method="post" class="grid gap-8 lg:grid-cols-3">
            {{ csrf_field()|raw }}

            {# Trappola anti-spam: invisibile alle persone, compilata dai bot. #}
            <div class="absolute left-[-9999px]" aria-hidden="true">
                <label for="website">Non compilare questo campo</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="space-y-6 lg:col-span-2">

                {# --- Dati di contatto --- #}
                <fieldset class="rounded-panel bg-white p-5 shadow-card sm:p-6">
                    <legend class="px-1 font-display text-lg font-bold text-viola-900">Come ricontattarti</legend>

                    <p class="mt-2 text-sm leading-relaxed text-sabbia-700">
                        Servono a farti sapere come procedere con il pagamento. Sono tutti obbligatori.
                    </p>

                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                        {{ include('components/field.twig', {
                            name: 'first_name', label: 'Nome', required: true,
                            autocomplete: 'given-name', maxlength: 80
                        }) }}
                        {{ include('components/field.twig', {
                            name: 'last_name', label: 'Cognome', required: true,
                            autocomplete: 'family-name', maxlength: 80
                        }) }}
                        {{ include('components/field.twig', {
                            name: 'email', label: 'Email', type: 'email', required: true,
                            autocomplete: 'email', maxlength: 190,
                            help: "Qui arriva il riepilogo dell'ordine."
                        }) }}
                        {{ include('components/field.twig', {
                            name: 'phone', label: 'Telefono', type: 'tel', required: true,
                            autocomplete: 'tel', inputmode: 'tel',
                            help: 'Per accordarci sul pagamento e sulla consegna.'
                        }) }}
                    </div>
                </fieldset>

                {# --- Indirizzo ---
                   Niente scelta fra consegna e ritiro: il gruppo spedisce e basta,
                   quindi l'indirizzo serve sempre e per intero. #}
                <fieldset class="rounded-panel bg-white p-5 shadow-card sm:p-6">
                    <legend class="px-1 font-display text-lg font-bold text-viola-900">Dove spedire</legend>

                    <div class="mt-4 grid gap-4 sm:grid-cols-6">
                        <div class="sm:col-span-6">
                            {{ include('components/field.twig', {
                                name: 'address', label: 'Indirizzo', required: true,
                                autocomplete: 'street-address', maxlength: 255,
                                placeholder: 'Via, numero civico, eventuale scala o interno'
                            }) }}
                        </div>
                        <div class="sm:col-span-2">
                            {{ include('components/field.twig', {
                                name: 'postal_code', label: 'CAP', required: true,
                                autocomplete: 'postal-code',
                                inputmode: 'numeric', maxlength: 5, pattern: '[0-9]{5}'
                            }) }}
                        </div>
                        <div class="sm:col-span-3">
                            {{ include('components/field.twig', {
                                name: 'city', label: 'Città', required: true,
                                autocomplete: 'address-level2', maxlength: 100
                            }) }}
                        </div>
                        <div class="sm:col-span-1">
                            {{ include('components/field.twig', {
                                name: 'province', label: 'Prov.', required: true,
                                autocomplete: 'address-level1',
                                maxlength: 2, placeholder: 'FI'
                            }) }}
                        </div>
                    </div>
                </fieldset>
            </div>

            {# --- Riepilogo --- #}
            <aside class="lg:col-span-1">
                <div class="sticky top-24 rounded-panel bg-white p-5 shadow-panel">
                    <h2 class="font-display text-lg font-bold text-viola-900">Il tuo ordine</h2>

                    <ul class="mt-4 space-y-3 border-b border-sabbia-200 pb-4" role="list">
                        {% for line in cart.lines %}
                            <li class="flex gap-3 text-sm">
                                <span class="h-12 w-12 shrink-0 overflow-hidden rounded-lg bg-sabbia-100">
                                    {{ include('components/responsive-image.twig', {
                                        key: line.imageKey, collection: 'products', alt: '', size: 'thumb',
                                        class: 'h-full w-full object-cover', sizes: '48px'
                                    }) }}
                                </span>
                                <span class="min-w-0 flex-1">
                                    <span class="block font-semibold leading-snug text-viola-900">{{ line.product.name }}</span>
                                    {% if line.variant %}
                                        <span class="block text-sabbia-600">{{ line.product.optionName }} {{ line.variant.label }}</span>
                                    {% endif %}
                                    <span class="block text-sabbia-600">{{ line.quantity }} x {{ line.unitPrice|euro }}</span>
                                </span>
                                <span class="shrink-0 font-semibold text-viola-900">{{ line.lineTotal|euro }}</span>
                            </li>
                        {% endfor %}
                    </ul>

                    <dl class="mt-4 text-sm">
                        <div class="flex justify-between">
                            <dt class="font-display text-base font-bold text-viola-900">
                                Totale articoli ({{ cart.totalQuantity }})
                            </dt>
                            <dd class="font-display text-lg font-extrabold text-viola-900">{{ cart.subtotal|euro }}</dd>
                        </div>
                    </dl>

                    <p class="mt-3 rounded-lg bg-viola-50 px-3 py-2.5 text-sm leading-relaxed text-viola-900 ring-1 ring-viola-200">
                        <strong>La spedizione non è inclusa</strong> ed è a carico di chi ordina.
                        Ti diciamo quanto costa quando ti ricontattiamo.
                    </p>

                    <button type="submit" class="btn-accento mt-5 w-full text-base">
                        Invia ordine
                    </button>

                    <p class="mt-3 text-center text-xs text-sabbia-600">
                        Inviando accetti il trattamento dei dati descritto nella
                        <a href="{{ route('page.privacy') }}" class="font-semibold text-viola-800 underline underline-offset-2 focus-ring rounded">privacy policy</a>.
                    </p>

                    <a href="{{ route('cart.show') }}" class="btn-fantasma mt-2 w-full text-sm">Torna al carrello</a>
                </div>
            </aside>
        </form>
    </section>
{% endblock %}
