{% extends 'layouts/site.twig' %}

{% block content %}
    {{ include('components/page-hero.twig', {
        eyebrow: 'Merchandising',
        title: 'Il tuo carrello',
        subtitle: 'Controlla gli articoli, poi passa alla richiesta d ordine. Nessun pagamento avviene sul sito.'
    }) }}

    <section class="mx-auto max-w-6xl px-4 py-section sm:px-6 lg:px-8">
        {% if cart.isEmpty %}
            {{ include('components/empty-state.twig', {
                icon: 'cart',
                title: 'Il carrello e vuoto',
                message: 'Aggiungi qualcosa dal catalogo: sciarpe, magliette, felpe e gadget ufficiali.',
                action: { url: route('shop.index'), label: 'Vai al catalogo' }
            }) }}
        {% else %}
            <div class="grid gap-8 lg:grid-cols-3">

                {# --- Righe --- #}
                <div class="lg:col-span-2">
                    <ul class="space-y-3" role="list">
                        {% for line in cart.lines %}
                            <li class="flex gap-4 rounded-card bg-white p-4 shadow-card">
                                <a href="{{ route('shop.show', { slug: line.product.slug }) }}"
                                   class="block h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-sabbia-100 focus-ring sm:h-24 sm:w-24">
                                    {{ include('components/responsive-image.twig', {
                                        key: line.imageKey, collection: 'products',
                                        alt: line.product.name, size: 'thumb',
                                        class: 'h-full w-full object-cover', sizes: '96px'
                                    }) }}
                                </a>

                                <div class="flex min-w-0 flex-1 flex-col">
                                    <h2 class="font-display text-base font-bold leading-snug text-viola-900">
                                        <a href="{{ route('shop.show', { slug: line.product.slug }) }}"
                                           class="rounded transition hover:text-viola-700 focus-ring">
                                            {{ line.product.name }}
                                        </a>
                                    </h2>

                                    {% if line.variant %}
                                        <p class="mt-0.5 text-sm text-sabbia-600">Variante: <strong class="font-semibold text-viola-900">{{ line.variant.label }}</strong></p>
                                    {% endif %}

                                    <p class="mt-0.5 text-sm text-sabbia-600">{{ line.unitPrice|euro }} cadauno</p>

                                    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                                        {# Ogni riga e un modulo autonomo: così funziona anche senza JavaScript. #}
                                        <form action="{{ route('cart.update') }}" method="post" data-autosubmit="true"
                                              class="flex items-center gap-2">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="line_key" value="{{ line.key }}">

                                            <label for="qta-{{ loop.index }}" class="sr-only">
                                                Quantita per {{ line.displayName }}
                                            </label>

                                            <div x-data="cartQuantity" data-quantity="{{ line.quantity }}" data-max="20"
                                                 class="inline-flex items-stretch overflow-hidden rounded-lg border border-sabbia-300 bg-white">
                                                <button type="button" @click="decrease"
                                                        class="flex w-9 items-center justify-center text-viola-800 transition hover:bg-viola-50 focus-ring">
                                                    <span class="sr-only">Diminuisci</span><span aria-hidden="true" class="font-bold">-</span>
                                                </button>
                                                <input type="number" id="qta-{{ loop.index }}" name="quantity"
                                                       x-model="quantity" @change="normalise"
                                                       value="{{ line.quantity }}" min="0" max="20" step="1" inputmode="numeric"
                                                       class="w-12 border-x border-sabbia-300 text-center text-sm font-semibold text-viola-900 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-viola-500/30">
                                                <button type="button" @click="increase"
                                                        class="flex w-9 items-center justify-center text-viola-800 transition hover:bg-viola-50 focus-ring">
                                                    <span class="sr-only">Aumenta</span><span aria-hidden="true" class="font-bold">+</span>
                                                </button>
                                            </div>

                                            {# Visibile solo senza JavaScript: con Alpine il modulo si invia da solo. #}
                                            <noscript>
                                                <button type="submit" class="btn-secondario btn-piccolo">Aggiorna</button>
                                            </noscript>
                                        </form>

                                        <div class="flex items-center gap-3">
                                            <span class="font-display text-base font-extrabold text-viola-900">{{ line.lineTotal|euro }}</span>

                                            <form action="{{ route('cart.remove') }}" method="post">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="line_key" value="{{ line.key }}">
                                                <button type="submit"
                                                        class="flex h-9 w-9 items-center justify-center rounded-lg text-sabbia-500 transition hover:bg-rosso-50 hover:text-rosso-700 focus-ring">
                                                    <span class="sr-only">Rimuovi {{ line.displayName }} dal carrello</span>
                                                    {{ include('components/icon.twig', { name: 'trash', class: 'h-4 w-4' }) }}
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                        <a href="{{ route('shop.index') }}" class="btn-secondario">
                            {{ include('components/icon.twig', { name: 'arrow-left', class: 'h-4 w-4' }) }}
                            Continua a guardare
                        </a>

                        <form action="{{ route('cart.clear') }}" method="post">
                            {{ csrf_field()|raw }}
                            <button type="submit" class="btn-fantasma text-sm">Svuota il carrello</button>
                        </form>
                    </div>
                </div>

                {# --- Riepilogo --- #}
                <aside class="lg:col-span-1">
                    <div class="sticky top-24 rounded-panel bg-white p-5 shadow-panel">
                        <h2 class="font-display text-lg font-bold text-viola-900">Riepilogo</h2>

                        <dl class="mt-4 space-y-2.5 text-sm">
                            <div class="flex justify-between">
                                <dt class="text-sabbia-700">Articoli ({{ cart.totalQuantity }})</dt>
                                <dd class="font-semibold text-viola-900">{{ cart.subtotal|euro }}</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-sabbia-700">Spedizione stimata</dt>
                                <dd class="font-semibold text-viola-900">
                                    {{ shippingCost > 0 ? shippingCost|euro : 'gratuita' }}
                                </dd>
                            </div>
                            <div class="flex justify-between border-t border-sabbia-200 pt-3">
                                <dt class="font-display text-base font-bold text-viola-900">Totale</dt>
                                <dd class="font-display text-lg font-extrabold text-viola-900">{{ total|euro }}</dd>
                            </div>
                        </dl>

                        {% if amountToFreeShipping %}
                            <p class="mt-4 rounded-lg bg-viola-50 px-3 py-2.5 text-sm text-viola-900 ring-1 ring-viola-200" role="status">
                                Aggiungi <strong>{{ amountToFreeShipping|euro }}</strong> per la spedizione gratuita.
                            </p>
                        {% endif %}

                        {% if shopEnabled %}
                            <a href="{{ route('order.create') }}" class="btn-accento mt-5 w-full text-base">
                                Procedi con l'ordine
                                {{ include('components/icon.twig', { name: 'arrow-right', class: 'h-5 w-5' }) }}
                            </a>
                        {% else %}
                            <p class="mt-5 rounded-lg bg-amber-50 px-3 py-2.5 text-sm text-amber-900 ring-1 ring-amber-200" role="status">
                                Gli ordini sono temporaneamente sospesi.
                            </p>
                        {% endif %}

                        <p class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-sabbia-600">
                            <span class="mt-0.5 shrink-0 text-viola-500">{{ include('components/icon.twig', { name: 'shield', class: 'h-4 w-4' }) }}</span>
                            Nessun pagamento avviene su questo sito: riceverai le istruzioni per pagare
                            in sede o con bonifico.
                        </p>
                    </div>
                </aside>
            </div>
        {% endif %}
    </section>
{% endblock %}
