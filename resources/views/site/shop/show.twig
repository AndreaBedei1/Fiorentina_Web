{% extends 'layouts/site.twig' %}

{% block content %}
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">

            {# --- Immagini --- #}
            <div>
                <div class="overflow-hidden rounded-panel bg-sabbia-100 shadow-card">
                    {{ include('components/responsive-image.twig', {
                        key: product.primaryImage ? product.primaryImage.storageKey : null,
                        collection: 'products',
                        alt: product.primaryImage ? product.primaryImage.alt(product.name) : product.name,
                        eager: true,
                        class: 'aspect-square w-full object-cover',
                        sizes: '(min-width: 1024px) 40rem, 100vw'
                    }) }}
                </div>

                {% if product.images|length > 1 %}
                    <ul class="mt-3 grid grid-cols-4 gap-2" role="list">
                        {% for image in product.images %}
                            <li class="overflow-hidden rounded-card bg-sabbia-100">
                                {{ include('components/responsive-image.twig', {
                                    key: image.storageKey, collection: 'products',
                                    alt: image.alt(product.name),
                                    size: 'thumb',
                                    class: 'aspect-square w-full object-cover',
                                    sizes: '25vw'
                                }) }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {# --- Dettagli e ordine --- #}
            <div>
                {% if product.categoryName %}
                    <a href="{{ route('shop.index') }}?categoria={{ product.categorySlug }}"
                       class="text-2xs font-bold uppercase tracking-[0.16em] text-rosso-700 underline-offset-4 hover:underline focus-ring rounded">
                        {{ product.categoryName }}
                    </a>
                {% endif %}

                <h1 class="mt-2 font-display text-display-sm font-extrabold leading-tight text-viola-900">{{ product.name }}</h1>

                <div class="mt-4">
                    <span class="font-display text-3xl font-extrabold text-viola-900">{{ product.price|euro }}</span>
                    <p class="mt-1 text-sm text-sabbia-600">
                        Prezzo unico per tutte le taglie. La spedizione non è compresa ed è a carico di chi ordina.
                    </p>
                </div>


                {% if product.shortDescription %}
                    <p class="mt-5 text-base leading-relaxed text-sabbia-700">{{ product.shortDescription }}</p>
                {% endif %}

                {# --- Modulo di aggiunta al carrello --- #}
                {% if shopEnabled %}
                    <form action="{{ route('cart.add') }}" method="post" class="mt-7 space-y-5">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="product_id" value="{{ product.id }}">

                        {% if product.hasVariants %}
                            <fieldset>
                                <legend class="campo-label" data-required>{{ product.optionName }}</legend>

                                <div class="flex flex-wrap gap-2">
                                    {% for variant in product.variants %}
                                        <label class="relative">
                                            <input type="radio" name="variant_id" value="{{ variant.id }}"
                                                   class="peer sr-only"
                                                   {{ loop.first ? 'checked' : '' }}
                                                   required>
                                            <span class="flex min-w-14 cursor-pointer items-center justify-center rounded-lg border-2 border-sabbia-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-viola-900 transition
                                                         peer-checked:border-viola-700 peer-checked:bg-viola-50
                                                         peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-rosso-600
                                                         peer-disabled:cursor-not-allowed peer-disabled:border-sabbia-200 peer-disabled:bg-sabbia-100 peer-disabled:text-sabbia-400 peer-disabled:line-through">
                                                {{ variant.label }}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </fieldset>
                        {% endif %}

                        <div x-data="cartQuantity" data-quantity="1" data-max="20">
                            <label for="quantita" class="campo-label">Quantita</label>
                            <div class="inline-flex items-stretch overflow-hidden rounded-lg border border-sabbia-300 bg-white">
                                <button type="button" @click="decrease"
                                        class="flex w-11 items-center justify-center text-viola-800 transition hover:bg-viola-50 focus-ring">
                                    <span class="sr-only">Diminuisci quantita</span>
                                    <span aria-hidden="true" class="text-lg font-bold">-</span>
                                </button>

                                <input type="number" id="quantita" name="quantity" x-model="quantity" @change="normalise"
                                       min="1" max="20" step="1" inputmode="numeric"
                                       class="w-14 border-x border-sabbia-300 text-center text-base font-semibold text-viola-900 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-viola-500/30">

                                <button type="button" @click="increase"
                                        class="flex w-11 items-center justify-center text-viola-800 transition hover:bg-viola-50 focus-ring">
                                    <span class="sr-only">Aumenta quantita</span>
                                    <span aria-hidden="true" class="text-lg font-bold">+</span>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn-accento w-full text-base sm:w-auto sm:px-8">
                            {{ include('components/icon.twig', { name: 'cart', class: 'h-5 w-5' }) }}
                            Aggiungi al carrello
                        </button>
                    </form>
                {% else %}
                    <div class="mt-7 rounded-card bg-sabbia-100 px-4 py-4 text-sm text-sabbia-700">
                        <p class="font-semibold text-viola-900">Questo articolo non è ordinabile online.</p>
                        <p class="mt-1">
                            Scrivici per sapere se è disponibile in sede:
                            <a href="{{ route('contact.show') }}" class="font-semibold text-viola-800 underline underline-offset-2 focus-ring rounded">contattaci</a>.
                        </p>
                    </div>
                {% endif %}

                {# --- Come funziona l ordine --- #}
                <div class="mt-7 rounded-card border border-sabbia-200 bg-white p-4">
                    <h2 class="font-display text-sm font-bold text-viola-900">Come funziona</h2>
                    <ol class="mt-3 space-y-2 text-sm text-sabbia-700">
                        <li class="flex gap-2">
                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-viola-100 text-2xs font-bold text-viola-800">1</span>
                            Invii l'ordine dal sito lasciando nome, recapiti e indirizzo: non ti viene chiesto nessun dato di pagamento.
                        </li>
                        <li class="flex gap-2">
                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-viola-100 text-2xs font-bold text-viola-800">2</span>
                            Ti ricontattiamo per dirti come pagare e quanto costa la spedizione.
                        </li>
                        <li class="flex gap-2">
                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-viola-100 text-2xs font-bold text-viola-800">3</span>
                            Ricevi il pacco all'indirizzo che ci hai indicato.
                        </li>
                    </ol>
                </div>
            </div>
        </div>

        {# --- Descrizione estesa --- #}
        {% if product.description %}
            <div class="mt-12 max-w-3xl">
                <h2 class="font-display text-xl font-bold text-viola-900">Descrizione</h2>
                <div class="contenuto mt-3">{{ product.description|raw }}</div>
            </div>
        {% endif %}
    </section>

{% endblock %}
