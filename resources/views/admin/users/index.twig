{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', { title: 'Amministratori' }) }}

    {#
      La differenza fra i due ruoli detta una volta sola, in alto.

      Non e una regola da ricordare: e quello che serve sapere prima di
      scegliere il ruolo di chi si sta invitando, e prima di premere
      "promuovi".
    #}
    <div class="mb-5 flex items-start gap-3 rounded-card border border-viola-200 bg-viola-50 px-4 py-3.5 text-sm text-viola-900">
        <span class="mt-0.5 shrink-0 text-viola-600">{{ include('components/icon.twig', { name: 'info', class: 'h-5 w-5' }) }}</span>
        <p class="leading-relaxed">
            Tutti gli amministratori possono scrivere e modificare i contenuti del sito: notizie,
            eventi, fotografie, prodotti, ordini.
            <strong>Solo il super amministratore</strong> può invitare nuovi amministratori,
            rimuoverli e cambiarne il ruolo.
        </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">

        <div class="space-y-5 lg:col-span-2">

            {# --- Elenco --- #}
            <section class="pannello overflow-hidden">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Account</h2>
                </div>

                <div class="tabella-scroll">
                    <table class="tabella">
                        <caption class="sr-only">Elenco degli amministratori</caption>
                        <thead>
                            <tr>
                                <th scope="col">Persona</th>
                                <th scope="col" class="w-56">Ruolo</th>
                                <th scope="col" class="w-52"><span class="sr-only">Azioni</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>
                                        <div class="flex items-center gap-2.5">
                                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-viola-100 text-2xs font-bold text-viola-700" aria-hidden="true">
                                                {{ user.name|iniziali }}
                                            </span>
                                            <span class="min-w-0">
                                                <span class="block truncate font-semibold text-viola-900">
                                                    {{ user.name }}
                                                    {% if user.id == currentUserId %}
                                                        <span class="ml-1 text-xs font-normal text-sabbia-500">(tu)</span>
                                                    {% endif %}
                                                </span>
                                                <span class="block truncate text-xs text-sabbia-500">{{ user.email }}</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="badge {{ user.isSuperAdmin ? 'badge-info' : 'badge-neutro' }}">{{ user.roleLabel }}</span>

                                            {#
                                              Il cambio di ruolo e un pulsante, non una tendina da
                                              confermare: le scelte sono due e si dice quale delle
                                              due si sta facendo.

                                              Su se stessi non compare: declassarsi da soli
                                              chiuderebbe la porta dall'interno.
                                            #}
                                            {% if user.id != currentUserId %}
                                                <form action="{{ route('admin.users.role', { id: user.id }) }}" method="post">
                                                    {{ csrf_field()|raw }}
                                                    <input type="hidden" name="role" value="{{ user.isSuperAdmin ? 'ADMIN' : 'SUPER_ADMIN' }}">
                                                    <button type="submit" class="btn-fantasma btn-piccolo">
                                                        {% if user.isSuperAdmin %}
                                                            Riporta ad amministratore
                                                        {% else %}
                                                            Promuovi a super amministratore
                                                        {% endif %}
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        {% if user.id != currentUserId %}
                                            <div class="flex flex-wrap items-center justify-end gap-1.5">
                                                {% if user.isPending %}
                                                    <form action="{{ route('admin.users.resend', { id: user.id }) }}" method="post">
                                                        {{ csrf_field()|raw }}
                                                        <button type="submit" class="btn-secondario btn-piccolo">
                                                            {{ include('components/icon.twig', { name: 'mail', class: 'h-3.5 w-3.5' }) }}
                                                            Reinvia invito
                                                        </button>
                                                    </form>
                                                {% elseif user.isBlocked %}
                                                    <form action="{{ route('admin.users.unblock', { id: user.id }) }}" method="post">
                                                        {{ csrf_field()|raw }}
                                                        <button type="submit" class="btn-secondario btn-piccolo">Sblocca</button>
                                                    </form>
                                                {% else %}
                                                    {{ include('components/admin-delete-button.twig', {
                                                        action: route('admin.users.block', { id: user.id }),
                                                        label: 'Blocca', icon: 'shield',
                                                        question: 'Bloccare l\'account di ' ~ user.name ~ '?'
                                                    }) }}
                                                {% endif %}

                                                {{ include('components/admin-delete-button.twig', {
                                                    action: route('admin.users.destroy', { id: user.id }),
                                                    question: 'Eliminare l\'account di ' ~ user.name ~ '?'
                                                }) }}
                                            </div>
                                        {% else %}
                                            <div class="text-right">
                                                <a href="{{ route('admin.profile') }}" class="btn-fantasma btn-piccolo">Il mio profilo</a>
                                            </div>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            {# --- Inviti in attesa --- #}
            {% if pendingInvites is not empty %}
                <section class="pannello overflow-hidden">
                    <div class="pannello-testata">
                        <h2 class="font-display text-base font-bold text-viola-900">Inviti in attesa</h2>
                    </div>

                    <ul class="divide-y divide-sabbia-100" role="list">
                        {% for invite in pendingInvites %}
                            <li class="flex flex-wrap items-center gap-3 px-5 py-3 text-sm">
                                <span class="min-w-0 flex-1">
                                    <span class="block font-semibold text-viola-900">{{ invite.name }}</span>
                                    <span class="block truncate text-xs text-sabbia-500">{{ invite.email }}</span>
                                </span>
                                <span class="text-xs text-sabbia-500">
                                    scade il {{ invite.expires_at|data_numerica }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </div>

        {# --- Invito --- #}
        <div class="lg:col-span-1">
            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Invita un amministratore</h2>
                </div>

                <form action="{{ route('admin.users.invite') }}" method="post" class="pannello-corpo space-y-4">
                    {{ csrf_field()|raw }}

                    {{ include('components/field.twig', {
                        name: 'name', label: 'Nome e cognome', required: true, maxlength: 120
                    }) }}

                    {{ include('components/field.twig', {
                        name: 'email', label: 'Email', type: 'email', required: true, maxlength: 190
                    }) }}

                    {{ include('components/field.twig', {
                        name: 'role', label: 'Ruolo', type: 'select',
                        options: { 'ADMIN': 'Amministratore', 'SUPER_ADMIN': 'Super amministratore' },
                        value: 'ADMIN'
                    }) }}

                    <button type="submit" class="btn-primario w-full">
                        {{ include('components/icon.twig', { name: 'mail', class: 'h-4 w-4' }) }}
                        Invia l'invito
                    </button>

                    <p class="text-xs leading-relaxed text-sabbia-600">
                        La persona riceverà un collegamento monouso per scegliere la propria password.
                        Nessuno, nemmeno tu, potrà conoscerla.
                    </p>
                </form>
            </section>
        </div>
    </div>
{% endblock %}
