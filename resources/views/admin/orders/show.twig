{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', {
        title: 'Ordine ' ~ order.orderNumber,
        description: 'Ricevuto il ' ~ order.createdAt|data_ora,
        back: { url: route('admin.orders.index'), label: 'Torna agli ordini' }
    }) }}

    <div class="grid gap-5 lg:grid-cols-3">

        <div class="space-y-5 lg:col-span-2">

            {# --- Articoli --- #}
            <section class="pannello overflow-hidden">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Articoli richiesti</h2>
                    <span class="badge {{ order.statusClasses }}">{{ order.statusLabel }}</span>
                </div>

                <div class="tabella-scroll">
                    <table class="tabella">
                        <caption class="sr-only">Articoli dell'ordine {{ order.orderNumber }}</caption>
                        <thead>
                            <tr>
                                <th scope="col">Prodotto</th>
                                <th scope="col" class="w-24">Prezzo</th>
                                <th scope="col" class="w-16">Qta</th>
                                <th scope="col" class="w-28">Totale</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in order.items %}
                                <tr>
                                    <td>
                                        {# Il nome porta alla scheda pubblica: fra due magliette
                                           con nomi simili si fa presto a prendere lo scatolone
                                           sbagliato. Se il prodotto non c'e piu, resta scritto. #}
                                        {% if item.productUrlKey %}
                                            <a href="{{ route('shop.show', { riferimento: item.productUrlKey }) }}"
                                               target="_blank" rel="noopener"
                                               class="font-semibold text-viola-900 underline underline-offset-2 hover:text-viola-700 focus-ring rounded">
                                                {{ item.productName }}
                                                <span class="sr-only">(si apre in una nuova scheda)</span>
                                            </a>
                                        {% else %}
                                            <span class="font-semibold text-viola-900">{{ item.productName }}</span>
                                        {% endif %}
                                        {% if item.variantLabel %}
                                            <span class="mt-0.5 block text-xs text-sabbia-500">{{ item.choiceLabel }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-sm">{{ item.unitPrice|euro }}</td>
                                    <td class="text-sm font-semibold">{{ item.quantity }}</td>
                                    <td class="text-sm font-semibold text-viola-900">{{ item.lineTotal|euro }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-right font-display text-base font-bold text-viola-900">
                                    Totale articoli
                                </td>
                                <td class="font-display text-base font-extrabold text-viola-900">{{ order.total|euro }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        </div>

        {# --- Colonna laterale --- #}
        <div class="space-y-5 lg:col-span-1">

            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Cliente</h2>
                </div>

                <div class="pannello-corpo">
                    <dl class="space-y-3 text-sm">
                        <div>
                            <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Nome</dt>
                            <dd class="mt-0.5 font-semibold text-viola-900">{{ order.customerName }}</dd>
                        </div>
                        <div>
                            <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Email</dt>
                            <dd class="mt-0.5">
                                <a href="mailto:{{ order.customerEmail }}" class="break-all text-viola-800 underline underline-offset-2 focus-ring rounded">
                                    {{ order.customerEmail }}
                                </a>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Telefono</dt>
                            <dd class="mt-0.5">
                                <a href="tel:{{ order.customerPhone|replace({' ': ''}) }}" class="text-viola-800 underline underline-offset-2 focus-ring rounded">
                                    {{ order.customerPhone }}
                                </a>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Spedire a</dt>
                            <dd class="mt-0.5 text-sabbia-800">{{ order.shippingLine }}</dd>
                        </div>
                    </dl>
                </div>
            </section>

            {#
              L'unica cosa che si puo fare a un ordine.

              Il modulo porta gia scritto in quale verso si sta andando, cosi il
              pulsante resta uno solo e premerlo due volte di fila non fa avanti
              e indietro a sorpresa.
            #}
            <section class="pannello">
                <div class="pannello-corpo">
                    <form action="{{ route('admin.orders.completed', { id: order.id }) }}" method="post">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="completato" value="{{ order.isCompleted ? '0' : '1' }}">

                        {% if order.isCompleted %}
                            <p class="mb-3 flex items-start gap-2 text-sm text-emerald-800">
                                <span class="mt-0.5 shrink-0">{{ include('components/icon.twig', { name: 'check', class: 'h-4 w-4' }) }}</span>
                                Questo ordine è completato.
                            </p>
                            <button type="submit" class="btn-secondario w-full">
                                Riportalo fra quelli da gestire
                            </button>
                        {% else %}
                            <button type="submit" class="btn-primario w-full">
                                {{ include('components/icon.twig', { name: 'check', class: 'h-4 w-4' }) }}
                                Segna come completato
                            </button>
                        {% endif %}
                    </form>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
