{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', { title: 'Ordini' }) }}

    {#
      Filtri rapidi per stato.

      Senza il pulsante "Tutti" serve comunque una via di ritorno, altrimenti
      chi sceglie uno stato resta chiuso li dentro. Lo stato acceso si spegne
      premendolo di nuovo: porta la crocetta per dirlo, e l'indirizzo torna
      quello dell'elenco intero.
    #}
    <nav class="mb-4 flex flex-wrap gap-2" aria-label="Filtra per stato">
        {% for value, label in statuses %}
            {% set count = counts[value]|default(0) %}
            {% set attivo = activeStatus == value %}
            {% if count > 0 or attivo %}
                <a href="{{ route('admin.orders.index') }}{{ attivo ? '' : '?stato=' ~ value }}"
                   class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold transition focus-ring
                          {{ attivo ? 'bg-viola-800 text-white' : 'bg-white text-viola-800 ring-1 ring-sabbia-300 hover:bg-viola-50' }}"
                   {{ attivo ? 'aria-current="true"' : '' }}>
                    {{ label }}
                    <span class="text-2xs opacity-70">{{ count }}</span>
                    {% if attivo %}
                        <span class="sr-only">- premi per togliere il filtro</span>
                        <span aria-hidden="true" class="text-base leading-none">&times;</span>
                    {% endif %}
                </a>
            {% endif %}
        {% endfor %}
    </nav>

    <form action="{{ route('admin.orders.index') }}" method="get" class="mb-4 flex flex-wrap items-end gap-3" role="search">
        {% if activeStatus %}<input type="hidden" name="stato" value="{{ activeStatus }}">{% endif %}
        <div class="min-w-0 flex-1 sm:max-w-xs">
            <label for="filtro-ricerca" class="campo-label">Cerca</label>
            <input type="search" id="filtro-ricerca" name="q" value="{{ search }}" class="campo-input"
                   placeholder="Numero d'ordine, nome o email">
        </div>
        <button type="submit" class="btn-primario">
            {{ include('components/icon.twig', { name: 'search', class: 'h-4 w-4' }) }}
            Filtra
        </button>
        {% if search %}<a href="{{ route('admin.orders.index') }}" class="btn-fantasma">Azzera</a>{% endif %}
    </form>

    <div class="pannello overflow-hidden">
        {% if paginator.isEmpty %}
            {{ include('components/admin-empty.twig', {
                icon: 'cart', title: 'Nessun ordine',
                message: 'Le richieste inviate dal sito compariranno qui.'
            }) }}
        {% else %}
            <div class="tabella-scroll">
                <table class="tabella">
                    <caption class="sr-only">Elenco degli ordini ricevuti</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="w-40">Numero</th>
                            <th scope="col">Cliente</th>
                            <th scope="col" class="w-28">Totale</th>
                            <th scope="col" class="w-40">Stato</th>
                            <th scope="col" class="w-32">Ricevuto</th>
                            <th scope="col" class="w-24"><span class="sr-only">Azioni</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in paginator.items %}
                            <tr class="riga-apribile">
                                <td>
                                    <a href="{{ route('admin.orders.show', { id: order.id }) }}"
                                       class="apre-la-riga font-mono text-sm font-semibold text-viola-900 hover:text-viola-700 focus-ring rounded">
                                        {{ order.orderNumber }}
                                    </a>
                                </td>
                                <td>
                                    <span class="block font-semibold text-viola-900">{{ order.customerName }}</span>
                                    <span class="block text-xs text-sabbia-500">{{ order.customerEmail }}</span>
                                </td>
                                <td class="font-semibold text-viola-900">{{ order.total|euro }}</td>
                                <td><span class="badge {{ order.statusClasses }}">{{ order.statusLabel }}</span></td>
                                <td class="text-sm text-sabbia-600">{{ order.createdAt|data_numerica }}</td>
                                <td class="text-right">
                                    <a href="{{ route('admin.orders.show', { id: order.id }) }}"
                                       class="sopra-il-velo btn-secondario btn-piccolo"
                                       tabindex="-1" aria-hidden="true">
                                        Apri
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {{ include('components/pagination.twig', { paginator: paginator }) }}
{% endblock %}
