{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', {
        title: 'Messaggi',
        description: 'Messaggi ricevuti dal modulo contatti del sito.'
    }) }}

    <nav class="mb-4 flex flex-wrap gap-2" aria-label="Filtra per stato">
        <a href="{{ route('admin.messages.index') }}"
           class="rounded-lg px-3 py-2 text-sm font-semibold transition focus-ring
                  {{ activeStatus is empty ? 'bg-viola-800 text-white' : 'bg-white text-viola-800 ring-1 ring-sabbia-300 hover:bg-viola-50' }}"
           {{ activeStatus is empty ? 'aria-current="true"' : '' }}>Tutti</a>
        {% for value, label in statuses %}
            <a href="{{ route('admin.messages.index') }}?stato={{ value }}"
               class="rounded-lg px-3 py-2 text-sm font-semibold transition focus-ring
                      {{ activeStatus == value ? 'bg-viola-800 text-white' : 'bg-white text-viola-800 ring-1 ring-sabbia-300 hover:bg-viola-50' }}"
               {{ activeStatus == value ? 'aria-current="true"' : '' }}>{{ label }}</a>
        {% endfor %}
    </nav>

    <div class="pannello overflow-hidden">
        {% if paginator.isEmpty %}
            {{ include('components/admin-empty.twig', {
                icon: 'mail', title: 'Nessun messaggio',
                message: 'I messaggi inviati dal modulo contatti compariranno qui.'
            }) }}
        {% else %}
            <ul class="divide-y divide-sabbia-100" role="list">
                {% for message in paginator.items %}
                    <li>
                        <a href="{{ route('admin.messages.show', { id: message.id }) }}"
                           class="flex flex-wrap items-center gap-3 px-5 py-4 transition hover:bg-viola-50/50 focus-ring">
                            <span class="h-2 w-2 shrink-0 rounded-full {{ message.isNew ? 'bg-rosso-500' : 'bg-sabbia-300' }}" aria-hidden="true"></span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate {{ message.isNew ? 'font-bold' : 'font-semibold' }} text-viola-900">
                                    {{ message.subject }}
                                </span>
                                <span class="block truncate text-sm text-sabbia-600">
                                    {{ message.name }} - {{ message.email }}
                                </span>
                            </span>
                            <span class="shrink-0 text-right">
                                <span class="block text-xs text-sabbia-500">{{ message.createdAt|data_numerica }}</span>
                                <span class="badge {{ message.isNew ? 'badge-errore' : 'badge-neutro' }} mt-0.5">{{ message.statusLabel }}</span>
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    {{ include('components/pagination.twig', { paginator: paginator }) }}
{% endblock %}
