{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', {
        title: message.subject,
        description: 'Ricevuto il ' ~ message.createdAt|data_ora,
        back: { url: route('admin.messages.index'), label: 'Torna ai messaggi' }
    }) }}

    <div class="grid gap-5 lg:grid-cols-3">

        <section class="pannello lg:col-span-2">
            <div class="pannello-testata">
                <h2 class="font-display text-base font-bold text-viola-900">Messaggio</h2>
                <span class="badge badge-neutro">{{ message.statusLabel }}</span>
            </div>

            <div class="pannello-corpo">
                <p class="whitespace-pre-line text-base leading-relaxed text-sabbia-800">{{ message.message }}</p>
            </div>
        </section>

        <div class="space-y-5 lg:col-span-1">
            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Mittente</h2>
                </div>

                <div class="pannello-corpo">
                    <dl class="space-y-3 text-sm">
                        <div>
                            <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Nome</dt>
                            <dd class="mt-0.5 font-semibold text-viola-900">{{ message.name }}</dd>
                        </div>
                        <div>
                            <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Email</dt>
                            <dd class="mt-0.5">
                                <a href="mailto:{{ message.email }}?subject=Re: {{ message.subject|url_encode }}"
                                   class="break-all text-viola-800 underline underline-offset-2 focus-ring rounded">
                                    {{ message.email }}
                                </a>
                            </dd>
                        </div>
                        {% if message.ip %}
                            <div>
                                <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Indirizzo IP</dt>
                                <dd class="mt-0.5 font-mono text-xs text-sabbia-600">{{ message.ip }}</dd>
                            </div>
                        {% endif %}
                    </dl>

                    <a href="mailto:{{ message.email }}?subject=Re: {{ message.subject|url_encode }}" class="btn-primario mt-4 w-full">
                        {{ include('components/icon.twig', { name: 'mail', class: 'h-4 w-4' }) }}
                        Rispondi
                    </a>
                </div>
            </section>

            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Stato</h2>
                </div>

                <form action="{{ route('admin.messages.status', { id: message.id }) }}" method="post" class="pannello-corpo space-y-3">
                    {{ csrf_field()|raw }}
                    <div>
                        <label for="campo-status" class="sr-only">Nuovo stato del messaggio</label>
                        <select id="campo-status" name="status" class="campo-select">
                            {% for value, label in statuses %}
                                <option value="{{ value }}" {{ message.status == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn-secondario w-full">Aggiorna stato</button>
                </form>

                <div class="border-t border-sabbia-200 p-5">
                    {{ include('components/admin-delete-button.twig', {
                        action: route('admin.messages.destroy', { id: message.id }),
                        question: 'Eliminare definitivamente questo messaggio?',
                        buttonClass: 'btn-pericolo w-full'
                    }) }}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
