{% extends 'layouts/admin.twig' %}

{% block content %}
    <div class="mb-6">
        <h1 class="font-display text-2xl font-bold text-viola-900">Ciao {{ user.firstName }}</h1>
        <p class="mt-1 text-sm text-sabbia-600">
            {% if user.lastLoginAt %}
                Ultimo accesso {{ user.lastLoginAt|relativa }}.
            {% else %}
                Benvenuto nel pannello di gestione.
            {% endif %}
        </p>
    </div>

    {# =====================================================================
       AVVISI
       Compaiono solo quando c'e davvero qualcosa da fare: un pannello pieno
       di avvisi permanenti insegna a ignorarli.
       ===================================================================== #}
    {% if warnings is not empty %}
        <ul class="mb-6 space-y-2" role="list">
            {% for warning in warnings %}
                {% set tone = {
                    'danger':    { box: 'border-rosso-300 bg-rosso-50 text-rosso-900',   icon: 'alert', color: 'text-rosso-600' },
                    'warning':   { box: 'border-amber-300 bg-amber-50 text-amber-900',   icon: 'alert', color: 'text-amber-600' },
                    'attention': { box: 'border-viola-300 bg-viola-50 text-viola-900',   icon: 'cart',  color: 'text-viola-600' },
                    'info':      { box: 'border-sabbia-300 bg-white text-sabbia-800',    icon: 'info',  color: 'text-sabbia-500' }
                }[warning.level]|default({ box: 'border-sabbia-300 bg-white text-sabbia-800', icon: 'info', color: 'text-sabbia-500' }) %}

                <li class="flex flex-wrap items-center gap-3 rounded-card border px-4 py-3 text-sm {{ tone.box }}">
                    <span class="shrink-0 {{ tone.color }}">
                        {{ include('components/icon.twig', { name: tone.icon, class: 'h-5 w-5' }) }}
                    </span>
                    <p class="min-w-0 flex-1 font-medium">{{ warning.message }}</p>
                    {% if warning.action is defined and warning.url is defined %}
                        <a href="{{ warning.url }}" class="btn-secondario btn-piccolo shrink-0">{{ warning.action }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {# =====================================================================
       NUMERI
       ===================================================================== #}
    {% set tiles = [
        { label: 'Ordini aperti',     value: stats.orders.open,      note: stats.orders.total ~ ' totali',           url: route('admin.orders.index'),   icon: 'cart',  permission: 'orders.manage' },
        { label: 'Notizie pubblicate',value: stats.news.published,   note: stats.news.draft ~ ' bozze',              url: route('admin.news.index'),     icon: 'news',  permission: 'news.manage' },
        { label: 'Eventi in programma',value: stats.events.upcoming, note: stats.events.total ~ ' totali',           url: route('admin.events.index'),   icon: 'calendar', permission: 'events.manage' },
        { label: 'Fotografie',        value: stats.gallery.photos,   note: stats.gallery.albums ~ ' album',          url: route('admin.gallery.index'),  icon: 'image', permission: 'gallery.manage' },
        { label: 'Prodotti a catalogo',value: stats.products.published, note: stats.products.out_of_stock ~ ' esauriti', url: route('admin.products.index'), icon: 'shirt', permission: 'products.manage' },
        { label: 'Messaggi da leggere',value: stats.messages,        note: 'dal modulo contatti',                    url: route('admin.messages.index'), icon: 'mail',  permission: 'contacts.manage' }
    ] %}

    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {% for tile in tiles %}
            {% if can(tile.permission) %}
                <li>
                    <a href="{{ tile.url }}"
                       class="group flex items-center gap-4 rounded-panel border border-sabbia-200 bg-white p-4 transition hover:border-viola-300 hover:shadow-card focus-ring">
                        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-viola-50 text-viola-700 transition group-hover:bg-viola-100">
                            {{ include('components/icon.twig', { name: tile.icon, class: 'h-5 w-5' }) }}
                        </span>
                        <span class="min-w-0">
                            <span class="block font-display text-2xl font-extrabold leading-none text-viola-900">{{ tile.value }}</span>
                            <span class="mt-1 block text-sm font-semibold text-sabbia-800">{{ tile.label }}</span>
                            <span class="block text-xs text-sabbia-500">{{ tile.note }}</span>
                        </span>
                    </a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>

    <div class="mt-6 grid gap-5 lg:grid-cols-2">

        {# --- Ordini recenti --- #}
        {% if can('orders.manage') %}
            <section class="pannello" aria-labelledby="ordini-recenti">
                <div class="pannello-testata">
                    <h2 id="ordini-recenti" class="font-display text-base font-bold text-viola-900">Ordini recenti</h2>
                    <a href="{{ route('admin.orders.index') }}" class="btn-fantasma btn-piccolo">Vedi tutti</a>
                </div>

                {% if recentOrders is empty %}
                    {{ include('components/admin-empty.twig', {
                        icon: 'cart', title: 'Nessun ordine ricevuto',
                        message: 'Le richieste inviate dal sito compariranno qui.'
                    }) }}
                {% else %}
                    <ul class="divide-y divide-sabbia-100" role="list">
                        {% for order in recentOrders %}
                            <li>
                                <a href="{{ route('admin.orders.show', { id: order.id }) }}"
                                   class="flex items-center gap-3 px-5 py-3 transition hover:bg-viola-50/50 focus-ring">
                                    <span class="min-w-0 flex-1">
                                        <span class="block font-mono text-sm font-semibold text-viola-900">{{ order.orderNumber }}</span>
                                        <span class="block truncate text-sm text-sabbia-600">{{ order.customerName }}</span>
                                    </span>
                                    <span class="shrink-0 text-right">
                                        <span class="block font-display text-sm font-bold text-viola-900">{{ order.total|euro }}</span>
                                        <span class="badge {{ order.statusClasses }} mt-0.5">{{ order.statusLabel }}</span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}

        {# --- Prossimi appuntamenti --- #}
        <section class="pannello" aria-labelledby="prossimi-appuntamenti">
            <div class="pannello-testata">
                <h2 id="prossimi-appuntamenti" class="font-display text-base font-bold text-viola-900">Prossimi appuntamenti</h2>
                {% if can('events.manage') %}
                    <a href="{{ route('admin.events.index') }}" class="btn-fantasma btn-piccolo">Gestisci</a>
                {% endif %}
            </div>

            <div class="pannello-corpo space-y-3">
                {% if nextMatch %}
                    <div class="rounded-card bg-viola-900 px-4 py-3 text-white">
                        <p class="text-2xs font-bold uppercase tracking-[0.12em] text-viola-300">{{ nextMatch.competition }}</p>
                        <p class="mt-1 font-display text-base font-bold">{{ nextMatch.title }}</p>
                        <p class="mt-0.5 text-sm text-viola-200">
                            {{ nextMatch.kickoffAt|data_estesa }}, ore {{ nextMatch.kickoffAt|ora }} - {{ nextMatch.venueLabel|lower }}
                        </p>
                    </div>
                {% endif %}

                {% if upcomingEvents is empty %}
                    <p class="py-6 text-center text-sm text-sabbia-600">Nessun evento in programma.</p>
                {% else %}
                    <ul class="space-y-2" role="list">
                        {% for event in upcomingEvents %}
                            <li class="flex items-center gap-3 rounded-card border border-sabbia-200 px-3 py-2.5">
                                <span class="flex w-11 shrink-0 flex-col items-center rounded-lg bg-sabbia-50 py-1.5">
                                    <span class="font-display text-base font-extrabold leading-none text-viola-900">{{ event.startsAt|giorno }}</span>
                                    <span class="text-2xs font-bold uppercase text-sabbia-600">{{ event.startsAt|mese_breve }}</span>
                                </span>
                                <span class="min-w-0 flex-1">
                                    <a href="{{ can('events.manage') ? route('admin.events.edit', { id: event.id }) : route('events.show', { slug: event.slug }) }}"
                                       class="block truncate text-sm font-semibold text-viola-900 hover:text-viola-700 focus-ring rounded">
                                        {{ event.title }}
                                    </a>
                                    <span class="block truncate text-xs text-sabbia-600">
                                        {{ event.startsAt|ora }}{% if event.locationLine %} - {{ event.locationLine }}{% endif %}
                                    </span>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>

        {# --- Ultime notizie --- #}
        {% if can('news.manage') %}
            <section class="pannello" aria-labelledby="ultime-notizie">
                <div class="pannello-testata">
                    <h2 id="ultime-notizie" class="font-display text-base font-bold text-viola-900">Ultime notizie pubblicate</h2>
                    <a href="{{ route('admin.news.create') }}" class="btn-fantasma btn-piccolo">
                        {{ include('components/icon.twig', { name: 'plus', class: 'h-3.5 w-3.5' }) }}
                        Nuova
                    </a>
                </div>

                {% if latestNews is empty %}
                    {{ include('components/admin-empty.twig', {
                        icon: 'news', title: 'Nessuna notizia pubblicata',
                        action: { url: route('admin.news.create'), label: 'Scrivi la prima notizia' }
                    }) }}
                {% else %}
                    <ul class="divide-y divide-sabbia-100" role="list">
                        {% for article in latestNews %}
                            <li>
                                <a href="{{ route('admin.news.edit', { id: article.id }) }}"
                                   class="flex items-center gap-3 px-5 py-3 transition hover:bg-viola-50/50 focus-ring">
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate text-sm font-semibold text-viola-900">{{ article.title }}</span>
                                        <span class="block text-xs text-sabbia-500">
                                            {{ article.publishedAt|data }} - {{ article.views }} visualizzazioni
                                        </span>
                                    </span>
                                    <span class="badge badge-successo shrink-0">{{ article.statusLabel }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}

        {# --- Attivita recenti: solo super amministratori --- #}
        {% if recentActivity is not empty %}
            <section class="pannello" aria-labelledby="attivita-recenti">
                <div class="pannello-testata">
                    <h2 id="attivita-recenti" class="font-display text-base font-bold text-viola-900">Attivita recenti</h2>
                    <a href="{{ route('admin.audit.index') }}" class="btn-fantasma btn-piccolo">Registro completo</a>
                </div>

                <ul class="divide-y divide-sabbia-100" role="list">
                    {% for entry in recentActivity %}
                        <li class="flex items-start gap-3 px-5 py-2.5">
                            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full {{ entry.isSensitive ? 'bg-rosso-500' : 'bg-viola-300' }}" aria-hidden="true"></span>
                            <span class="min-w-0 flex-1">
                                <span class="block text-sm text-sabbia-800">{{ entry.description ?? entry.action }}</span>
                                <span class="block text-xs text-sabbia-500">
                                    {{ entry.actorLabel }} - {{ entry.createdAt|relativa }}
                                </span>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>

    {# =====================================================================
       STATO TECNICO
       Utile a chi consegna il sito e a chi lo mantiene: dice a colpo d'occhio
       cosa e reale e cosa e ancora dimostrativo.
       ===================================================================== #}
    {% if can('settings.manage') %}
        <section class="pannello mt-5" aria-labelledby="stato-tecnico">
            <div class="pannello-testata">
                <h2 id="stato-tecnico" class="font-display text-base font-bold text-viola-900">Stato del sistema</h2>
            </div>

            <div class="pannello-corpo">
                <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <div>
                        <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Elaborazione immagini</dt>
                        <dd class="mt-1 text-sm text-sabbia-800">
                            Driver <strong class="text-viola-900">{{ systemInfo.imageDriver }}</strong>
                            <span class="block text-xs text-sabbia-500">
                                Filigrana: {{ systemInfo.watermarkReady ? 'attiva' : 'non disponibile' }}
                            </span>
                        </dd>
                    </div>

                    <div>
                        <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Calendario partite</dt>
                        <dd class="mt-1 text-sm text-sabbia-800">
                            Fornitore <strong class="text-viola-900">{{ systemInfo.footballProvider }}</strong>
                            <span class="block text-xs text-sabbia-500">
                                {{ systemInfo.footballLastSync ? 'Aggiornato ' ~ systemInfo.footballLastSync|relativa : 'Mai sincronizzato' }}
                            </span>
                        </dd>
                    </div>

                    <div>
                        <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Contenuti social</dt>
                        <dd class="mt-1 text-sm text-sabbia-800">
                            <strong class="text-viola-900">{{ systemInfo.socialMock ? 'dimostrativi' : 'reali' }}</strong>
                            <span class="block text-xs text-sabbia-500">
                                {{ systemInfo.socialLastSync ? 'Aggiornati ' ~ systemInfo.socialLastSync|relativa : 'Mai sincronizzati' }}
                            </span>
                        </dd>
                    </div>

                    <div>
                        <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Posta elettronica</dt>
                        <dd class="mt-1 text-sm text-sabbia-800">
                            Modalita <strong class="text-viola-900">{{ systemInfo.mailer }}</strong>
                            <span class="block text-xs text-sabbia-500">
                                {{ systemInfo.mailer == 'log' ? 'I messaggi sono salvati su file, non spediti' : 'Invio reale attivo' }}
                            </span>
                        </dd>
                    </div>

                    {% if stats.users %}
                        <div>
                            <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Amministratori</dt>
                            <dd class="mt-1 text-sm text-sabbia-800">
                                <strong class="text-viola-900">{{ stats.users.active }}</strong> attivi
                                <span class="block text-xs text-sabbia-500">
                                    {{ stats.users.pending }} inviti in attesa, {{ stats.users.blocked }} bloccati
                                </span>
                            </dd>
                        </div>
                    {% endif %}

                    <div>
                        <dt class="text-2xs font-bold uppercase tracking-[0.12em] text-sabbia-500">Ambiente</dt>
                        <dd class="mt-1 text-sm text-sabbia-800">
                            <strong class="text-viola-900">{{ app_env }}</strong>
                            <span class="block text-xs text-sabbia-500">Debug: {{ app_debug ? 'attivo' : 'disattivato' }}</span>
                        </dd>
                    </div>
                </dl>
            </div>
        </section>
    {% endif %}
{% endblock %}
