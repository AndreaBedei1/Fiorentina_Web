{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', {
        title: 'Categorie',
        description: 'Categorie degli eventi e del catalogo merchandising.'
    }) }}

    <div class="grid gap-5 lg:grid-cols-2">

        {# --- Categorie evento --- #}
        <section class="pannello">
            <div class="pannello-testata">
                <h2 class="font-display text-base font-bold text-viola-900">Categorie evento</h2>
                <span class="text-xs text-sabbia-500">{{ eventCategories|length }}</span>
            </div>

            <div class="pannello-corpo space-y-2">
                {% for category in eventCategories %}
                    <details class="rounded-card border border-sabbia-200">
                        <summary class="flex cursor-pointer items-center gap-2 px-3 py-2.5 focus-ring rounded-card">
                            <span class="badge {{ category.badgeClasses }} shrink-0">
                                {{ include('components/icon.twig', { name: category.icon, class: 'h-3 w-3' }) }}
                                {{ category.name }}
                            </span>
                            <span class="min-w-0 flex-1 truncate text-xs text-sabbia-500">{{ category.description }}</span>
                        </summary>

                        <form action="{{ route('admin.taxonomy.events.update', { id: category.id }) }}" method="post"
                              class="space-y-2 border-t border-sabbia-200 p-3">
                            {{ csrf_field()|raw }}
                            <div>
                                <label for="cat-ev-{{ category.id }}-nome" class="campo-label text-xs">Nome</label>
                                <input type="text" id="cat-ev-{{ category.id }}-nome" name="name" value="{{ category.name }}"
                                       maxlength="100" class="campo-input text-sm">
                            </div>
                            <div>
                                <label for="cat-ev-{{ category.id }}-descrizione" class="campo-label text-xs">Descrizione</label>
                                <input type="text" id="cat-ev-{{ category.id }}-descrizione" name="description" value="{{ category.description }}"
                                       maxlength="300" class="campo-input text-sm">
                            </div>
                            <div class="grid grid-cols-3 gap-2">
                                <div>
                                    <label for="cat-ev-{{ category.id }}-icona" class="campo-label text-xs">Icona</label>
                                    <select id="cat-ev-{{ category.id }}-icona" name="icon" class="campo-select text-sm">
                                        {% for value, label in icons %}
                                            <option value="{{ value }}" {{ category.icon == value ? 'selected' : '' }}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div>
                                    <label for="cat-ev-{{ category.id }}-colore" class="campo-label text-xs">Colore</label>
                                    <select id="cat-ev-{{ category.id }}-colore" name="color" class="campo-select text-sm">
                                        {% for value, label in colors %}
                                            <option value="{{ value }}" {{ category.color == value ? 'selected' : '' }}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div>
                                    <label for="cat-ev-{{ category.id }}-ordine" class="campo-label text-xs">Ordine</label>
                                    <input type="number" id="cat-ev-{{ category.id }}-ordine" name="sort_order"
                                           value="{{ category.sortOrder }}" min="0" max="999" class="campo-input text-sm">
                                </div>
                            </div>
                            <button type="submit" class="btn-secondario btn-piccolo w-full">Salva</button>
                        </form>

                        <div class="border-t border-sabbia-200 p-3">
                            {{ include('components/admin-delete-button.twig', {
                                action: route('admin.taxonomy.events.destroy', { id: category.id }),
                                question: 'Eliminare la categoria?'
                            }) }}
                        </div>
                    </details>
                {% endfor %}

                <form action="{{ route('admin.taxonomy.events.store') }}" method="post"
                      class="rounded-card border border-dashed border-sabbia-300 p-3">
                    {{ csrf_field()|raw }}
                    <p class="mb-2 text-sm font-semibold text-viola-900">Nuova categoria evento</p>
                    <div class="space-y-2">
                        <div>
                            <label for="nuova-cat-ev-nome" class="sr-only">Nome</label>
                            <input type="text" id="nuova-cat-ev-nome" name="name" required placeholder="Nome"
                                   maxlength="100" class="campo-input text-sm">
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label for="nuova-cat-ev-icona" class="sr-only">Icona</label>
                                <select id="nuova-cat-ev-icona" name="icon" class="campo-select text-sm">
                                    {% for value, label in icons %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                                </select>
                            </div>
                            <div>
                                <label for="nuova-cat-ev-colore" class="sr-only">Colore</label>
                                <select id="nuova-cat-ev-colore" name="color" class="campo-select text-sm">
                                    {% for value, label in colors %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn-primario btn-piccolo w-full">
                            {{ include('components/icon.twig', { name: 'plus', class: 'h-3.5 w-3.5' }) }}
                            Aggiungi
                        </button>
                    </div>
                </form>
            </div>
        </section>

        {# --- Categorie prodotto --- #}
        <section class="pannello">
            <div class="pannello-testata">
                <h2 class="font-display text-base font-bold text-viola-900">Categorie prodotto</h2>
                <span class="text-xs text-sabbia-500">{{ productCategories|length }}</span>
            </div>

            <div class="pannello-corpo space-y-2">
                {% for category in productCategories %}
                    <details class="rounded-card border border-sabbia-200">
                        <summary class="flex cursor-pointer items-center justify-between gap-2 px-3 py-2.5 text-sm font-semibold text-viola-900 focus-ring rounded-card">
                            <span class="min-w-0 truncate">{{ category.name }}</span>
                            {% if not category.isActive %}
                                <span class="badge badge-neutro shrink-0">Nascosta</span>
                            {% endif %}
                        </summary>

                        <form action="{{ route('admin.taxonomy.products.update', { id: category.id }) }}" method="post"
                              class="space-y-2 border-t border-sabbia-200 p-3">
                            {{ csrf_field()|raw }}
                            <div>
                                <label for="cat-pr-{{ category.id }}-nome" class="campo-label text-xs">Nome</label>
                                <input type="text" id="cat-pr-{{ category.id }}-nome" name="name" value="{{ category.name }}"
                                       maxlength="100" class="campo-input text-sm">
                            </div>
                            <div>
                                <label for="cat-pr-{{ category.id }}-descrizione" class="campo-label text-xs">Descrizione</label>
                                <input type="text" id="cat-pr-{{ category.id }}-descrizione" name="description" value="{{ category.description }}"
                                       maxlength="300" class="campo-input text-sm">
                            </div>
                            <div>
                                <label for="cat-pr-{{ category.id }}-ordine" class="campo-label text-xs">Ordine</label>
                                <input type="number" id="cat-pr-{{ category.id }}-ordine" name="sort_order"
                                       value="{{ category.sortOrder }}" min="0" max="999" class="campo-input text-sm">
                            </div>
                            <label class="flex items-center gap-2 text-sm text-sabbia-700">
                                <input type="checkbox" name="active" value="1" class="campo-checkbox" {{ category.isActive ? 'checked' : '' }}>
                                <span>Visibile nel catalogo</span>
                            </label>
                            <button type="submit" class="btn-secondario btn-piccolo w-full">Salva</button>
                        </form>

                        <div class="border-t border-sabbia-200 p-3">
                            {{ include('components/admin-delete-button.twig', {
                                action: route('admin.taxonomy.products.destroy', { id: category.id }),
                                question: 'Eliminare la categoria?'
                            }) }}
                        </div>
                    </details>
                {% endfor %}

                <form action="{{ route('admin.taxonomy.products.store') }}" method="post"
                      class="rounded-card border border-dashed border-sabbia-300 p-3">
                    {{ csrf_field()|raw }}
                    <p class="mb-2 text-sm font-semibold text-viola-900">Nuova categoria prodotto</p>
                    <label for="nuova-cat-pr-nome" class="sr-only">Nome</label>
                    <input type="text" id="nuova-cat-pr-nome" name="name" required placeholder="Nome"
                           maxlength="100" class="campo-input text-sm">
                    <input type="hidden" name="active" value="1">
                    <button type="submit" class="btn-primario btn-piccolo mt-2 w-full">
                        {{ include('components/icon.twig', { name: 'plus', class: 'h-3.5 w-3.5' }) }}
                        Aggiungi
                    </button>
                </form>
            </div>
        </section>
    </div>
{% endblock %}
