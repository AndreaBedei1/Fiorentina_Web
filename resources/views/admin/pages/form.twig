{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', {
        title: page.title,
        description: 'Indirizzo pubblico: /' ~ page.slug,
        back: { url: route('admin.pages.index'), label: 'Torna alle pagine' }
    }) }}

    <div class="grid gap-5 lg:grid-cols-3">

        {# --- Testata e corpo --- #}
        <form action="{{ route('admin.pages.update', { id: page.id }) }}" method="post"
              enctype="multipart/form-data" class="space-y-5 lg:col-span-2">
            {{ csrf_field()|raw }}

            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Testata</h2>
                </div>

                <div class="pannello-corpo space-y-4">
                    {{ include('components/field.twig', {
                        name: 'title', label: 'Titolo', required: true, maxlength: 200,
                        value: old('title', page.title)
                    }) }}

                    {{ include('components/field.twig', {
                        name: 'subtitle', label: 'Sottotitolo', maxlength: 300,
                        value: old('subtitle', page.subtitle),
                        help: 'Compare sotto il titolo e viene usato come descrizione per Google.'
                    }) }}

                    {{ include('components/field.twig', {
                        name: 'intro', label: 'Introduzione', type: 'textarea', rows: 3, maxlength: 2000,
                        value: old('intro', page.intro),
                        help: 'Il paragrafo di apertura, in evidenza rispetto al resto del testo.'
                    }) }}

                    <div>
                        <label for="campo-content" class="campo-label">Testo della pagina</label>
                        <textarea id="campo-content" name="content" rows="16"
                                  class="campo-textarea font-mono text-sm">{{ old('content', page.content) }}</textarea>
                        <p class="campo-aiuto">
                            HTML semplice: &lt;p&gt;, &lt;h2&gt;, &lt;h3&gt;, &lt;strong&gt;, &lt;ul&gt;, &lt;li&gt;, &lt;a&gt;.
                        </p>
                    </div>

                    {{ include('components/field.twig', {
                        name: 'status', label: 'Stato', type: 'select',
                        options: { 'published': 'Pubblicata', 'draft': 'Bozza' },
                        value: old('status', page.status)
                    }) }}

                    <div class="grid gap-3 sm:grid-cols-2">
                        {{ include('components/field.twig', {
                            name: 'meta_title', label: 'Titolo per Google', maxlength: 200,
                            value: old('meta_title', page.metaTitle)
                        }) }}
                        {{ include('components/field.twig', {
                            name: 'meta_description', label: 'Descrizione per Google', maxlength: 300,
                            value: old('meta_description', page.metaDescription)
                        }) }}
                    </div>

                    {% if page.heroImageKey %}
                        <div>
                            <p class="campo-label">Immagine di testata attuale</p>
                            <figure class="overflow-hidden rounded-card bg-sabbia-100">
                                {{ include('components/responsive-image.twig', {
                                    key: page.heroImageKey, collection: 'pages',
                                    alt: page.heroImageAlt ?? page.title, size: 'medium',
                                    class: 'aspect-[21/9] w-full object-cover', sizes: '600px'
                                }) }}
                            </figure>
                            <label class="mt-2 flex items-start gap-2 text-sm text-sabbia-700">
                                <input type="checkbox" name="remove_hero_image" value="1" class="campo-checkbox mt-0.5">
                                <span>Rimuovi l'immagine di testata</span>
                            </label>
                        </div>
                    {% endif %}

                    {{ include('components/field.twig', {
                        name: 'hero_image', label: 'Immagine di testata', type: 'file',
                        accept: 'image/jpeg,image/png,image/webp'
                    }) }}

                    {{ include('components/field.twig', {
                        name: 'hero_image_alt', label: 'Testo alternativo', maxlength: 200,
                        value: old('hero_image_alt', page.heroImageAlt)
                    }) }}

                    <div class="border-t border-sabbia-200 pt-4">
                        <button type="submit" class="btn-primario">Salva pagina</button>
                    </div>
                </div>
            </section>
        </form>

        {# --- Blocchi --- #}
        <div class="space-y-5 lg:col-span-1">
            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Blocchi</h2>
                    <span class="text-xs text-sabbia-500">{{ page.blocks|length }}</span>
                </div>

                <div class="pannello-corpo space-y-3">
                    <p class="text-sm leading-relaxed text-sabbia-600">
                        I blocchi si aggiungono in fondo alla pagina, nell'ordine in cui compaiono qui.
                    </p>

                    {% for block in page.blocks %}
                        <details class="rounded-card border border-sabbia-200">
                            <summary class="flex cursor-pointer items-center justify-between gap-2 px-3 py-2.5 text-sm font-semibold text-viola-900 focus-ring rounded-card">
                                <span class="min-w-0 truncate">{{ block.title ?? 'Blocco senza titolo' }}</span>
                                <span class="badge badge-neutro shrink-0">{{ block.type }}</span>
                            </summary>

                            <form action="{{ route('admin.pages.blocks.update', { id: page.id, blockId: block.id }) }}"
                                  method="post" class="space-y-3 border-t border-sabbia-200 p-3">
                                {{ csrf_field()|raw }}

                                <div>
                                    <label for="blocco-{{ block.id }}-titolo" class="campo-label text-xs">Titolo</label>
                                    <input type="text" id="blocco-{{ block.id }}-titolo" name="title" value="{{ block.title }}"
                                           maxlength="200" class="campo-input text-sm">
                                </div>

                                <div>
                                    <label for="blocco-{{ block.id }}-sottotitolo" class="campo-label text-xs">Sottotitolo</label>
                                    <input type="text" id="blocco-{{ block.id }}-sottotitolo" name="subtitle" value="{{ block.subtitle }}"
                                           maxlength="300" class="campo-input text-sm">
                                </div>

                                {% if block.type in ['text', 'highlight', 'cta'] %}
                                    <div>
                                        <label for="blocco-{{ block.id }}-corpo" class="campo-label text-xs">Testo</label>
                                        <textarea id="blocco-{{ block.id }}-corpo" name="body" rows="4"
                                                  class="campo-textarea font-mono text-xs">{{ block.body }}</textarea>
                                    </div>
                                {% endif %}

                                {% if block.type in ['list', 'steps', 'stats', 'faq', 'timeline'] %}
                                    <div>
                                        <label for="blocco-{{ block.id }}-voci" class="campo-label text-xs">Voci</label>
                                        <textarea id="blocco-{{ block.id }}-voci" name="items_text" rows="6"
                                                  class="campo-textarea font-mono text-xs"
                                                  aria-describedby="blocco-{{ block.id }}-voci-aiuto">
{%- for item in block.items %}{{ item.title }}{% if item.text %} | {{ item.text }}{% endif %}
{% endfor -%}
                                        </textarea>
                                        <p id="blocco-{{ block.id }}-voci-aiuto" class="campo-aiuto">
                                            Una voce per riga. Per aggiungere una descrizione usa
                                            <code class="rounded bg-sabbia-100 px-1">Titolo | descrizione</code>.
                                        </p>
                                    </div>
                                {% endif %}

                                {% if block.type == 'cta' %}
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label for="blocco-{{ block.id }}-link" class="campo-label text-xs">Indirizzo</label>
                                            <input type="text" id="blocco-{{ block.id }}-link" name="link_url" value="{{ block.linkUrl }}"
                                                   maxlength="500" class="campo-input text-sm">
                                        </div>
                                        <div>
                                            <label for="blocco-{{ block.id }}-etichetta" class="campo-label text-xs">Testo del pulsante</label>
                                            <input type="text" id="blocco-{{ block.id }}-etichetta" name="link_label" value="{{ block.linkLabel }}"
                                                   maxlength="100" class="campo-input text-sm">
                                        </div>
                                    </div>
                                {% endif %}

                                <label class="flex items-center gap-2 text-sm text-sabbia-700">
                                    <input type="checkbox" name="is_visible" value="1" class="campo-checkbox"
                                           {{ block.isVisible ? 'checked' : '' }}>
                                    <span>Visibile sul sito</span>
                                </label>

                                <div class="flex gap-2">
                                    <button type="submit" class="btn-secondario btn-piccolo flex-1">Salva blocco</button>
                                </div>
                            </form>

                            <div class="border-t border-sabbia-200 p-3">
                                {{ include('components/admin-delete-button.twig', {
                                    action: route('admin.pages.blocks.destroy', { id: page.id, blockId: block.id }),
                                    question: 'Eliminare questo blocco?'
                                }) }}
                            </div>
                        </details>
                    {% endfor %}

                    {# --- Nuovo blocco --- #}
                    <form action="{{ route('admin.pages.blocks.store', { id: page.id }) }}" method="post"
                          class="rounded-card border border-dashed border-sabbia-300 p-3">
                        {{ csrf_field()|raw }}
                        <p class="mb-2 text-sm font-semibold text-viola-900">Aggiungi un blocco</p>

                        <div class="space-y-2">
                            <div>
                                <label for="nuovo-blocco-tipo" class="sr-only">Tipo di blocco</label>
                                <select id="nuovo-blocco-tipo" name="type" class="campo-select text-sm">
                                    {% for value, label in blockTypes %}
                                        <option value="{{ value }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label for="nuovo-blocco-titolo" class="sr-only">Titolo del blocco</label>
                                <input type="text" id="nuovo-blocco-titolo" name="title" placeholder="Titolo del blocco"
                                       maxlength="200" class="campo-input text-sm">
                            </div>
                            <input type="hidden" name="is_visible" value="1">
                            <button type="submit" class="btn-primario btn-piccolo w-full">
                                {{ include('components/icon.twig', { name: 'plus', class: 'h-3.5 w-3.5' }) }}
                                Aggiungi
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
