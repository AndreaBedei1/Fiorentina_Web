{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', {
        title: 'Pagine',
        description: 'Le pagine fisse del sito. Si modificano, non si eliminano: hanno un indirizzo fisso a cui puntano i menu.'
    }) }}

    <div class="pannello overflow-hidden">
        <ul class="divide-y divide-sabbia-100" role="list">
            {% for page in pages %}
                <li class="flex flex-wrap items-center gap-3 px-5 py-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-viola-50 text-viola-700">
                        {{ include('components/icon.twig', { name: 'file', class: 'h-5 w-5' }) }}
                    </span>

                    <div class="min-w-0 flex-1">
                        <a href="{{ route('admin.pages.edit', { id: page.id }) }}"
                           class="font-semibold text-viola-900 hover:text-viola-700 focus-ring rounded">
                            {{ page.title }}
                        </a>
                        <span class="mt-0.5 block text-xs text-sabbia-500">
                            /{{ page.slug }}
                            {% if page.updatedAt %} - aggiornata {{ page.updatedAt|relativa }}{% endif %}
                        </span>
                    </div>

                    <span class="badge {{ page.isPublished ? 'badge-successo' : 'badge-attenzione' }}">
                        {{ page.isPublished ? 'Pubblicata' : 'Bozza' }}
                    </span>

                    <a href="{{ route('admin.pages.edit', { id: page.id }) }}" class="btn-secondario btn-piccolo">
                        {{ include('components/icon.twig', { name: 'edit', class: 'h-3.5 w-3.5' }) }}
                        Modifica
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
