{% extends 'layouts/admin-auth.twig' %}

{% block card %}
    <h1 class="font-display text-xl font-bold text-viola-900">Password dimenticata</h1>
    <p class="mt-1.5 text-sm leading-relaxed text-sabbia-600">
        Inserisci l indirizzo email del tuo account: se corrisponde a un amministratore
        attivo riceverai un collegamento per scegliere una nuova password.
    </p>

    <form action="{{ route('admin.password.email') }}" method="post" class="mt-6 space-y-5">
        {{ csrf_field()|raw }}

        {{ include('components/field.twig', {
            name: 'email', label: 'Email', type: 'email', required: true,
            autocomplete: 'username', maxlength: 190
        }) }}

        <button type="submit" class="btn-primario w-full text-base">Invia il collegamento</button>
    </form>

    <p class="mt-6 text-center text-sm">
        <a href="{{ route('admin.login') }}" class="font-semibold text-viola-800 underline underline-offset-2 focus-ring rounded">
            Torna all accesso
        </a>
    </p>
{% endblock %}
