{% extends 'layouts/admin-auth.twig' %}

{% block card %}
    <h1 class="font-display text-xl font-bold text-viola-900">Attiva il tuo account</h1>

    <div class="mt-4 rounded-card bg-viola-50 px-4 py-3 text-sm ring-1 ring-viola-200">
        <p class="font-semibold text-viola-900">{{ invite.name }}</p>
        <p class="mt-0.5 text-viola-800">{{ invite.email }}</p>
        <p class="mt-1.5 text-2xs font-bold uppercase tracking-wide text-viola-700">
            Ruolo: {{ invite.role == 'SUPER_ADMIN' ? 'Super amministratore' : 'Amministratore' }}
        </p>
    </div>

    <p class="mt-4 text-sm leading-relaxed text-sabbia-600">
        Scegli una password personale. Nessun altro la conoscera: viene salvata solo
        in forma cifrata e non è recuperabile in chiaro.
    </p>

    <form action="{{ route('admin.invite.submit', { token: token }) }}" method="post" class="mt-6 space-y-5">
        {{ csrf_field()|raw }}

        <div>
            <label for="campo-password" class="campo-label" data-required>Password</label>
            <input type="password" id="campo-password" name="password" required
                   autocomplete="new-password" class="campo-input"
                   aria-describedby="campo-password-aiuto"
                   {{ has_error('password') ? 'aria-invalid="true"' : '' }}>
            <p id="campo-password-aiuto" class="campo-aiuto">
                {{ regolaPassword }}
            </p>
            {% if has_error('password') %}
                <p class="campo-errore">
                    <span class="mt-0.5 shrink-0">{{ include('components/icon.twig', { name: 'alert', class: 'h-4 w-4' }) }}</span>
                    {{ error('password') }}
                </p>
            {% endif %}
        </div>

        <div>
            <label for="campo-password-conferma" class="campo-label" data-required>Ripeti la password</label>
            <input type="password" id="campo-password-conferma" name="password_confirmation" required
                   autocomplete="new-password" class="campo-input"
                   {{ has_error('password_confirmation') ? 'aria-invalid="true"' : '' }}>
            {% if has_error('password_confirmation') %}
                <p class="campo-errore">
                    <span class="mt-0.5 shrink-0">{{ include('components/icon.twig', { name: 'alert', class: 'h-4 w-4' }) }}</span>
                    {{ error('password_confirmation') }}
                </p>
            {% endif %}
        </div>

        <button type="submit" class="btn-primario w-full text-base">Attiva l'account</button>
    </form>
{% endblock %}
