{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', {
        title: 'Galleria',
        description: 'Le fotografie sono organizzate in album. Crea prima l album, poi carica le immagini.',
        action: { url: route('admin.gallery.create'), label: 'Nuovo album' }
    }) }}

    <form action="{{ route('admin.gallery.index') }}" method="get" class="mb-4 flex flex-wrap items-end gap-3" role="search">
        <div class="min-w-0 flex-1 sm:max-w-xs">
            <label for="filtro-ricerca" class="campo-label">Cerca album</label>
            <input type="search" id="filtro-ricerca" name="q" value="{{ search }}" class="campo-input" placeholder="Titolo dell album">
        </div>
        <button type="submit" class="btn-primario">
            {{ include('components/icon.twig', { name: 'search', class: 'h-4 w-4' }) }}
            Filtra
        </button>
        {% if search %}<a href="{{ route('admin.gallery.index') }}" class="btn-fantasma">Azzera</a>{% endif %}
    </form>

    {% if paginator.isEmpty %}
        <div class="pannello">
            {{ include('components/admin-empty.twig', {
                icon: 'image', title: 'Nessun album',
                message: 'Crea il primo album per iniziare a caricare le fotografie del gruppo.',
                action: { url: route('admin.gallery.create'), label: 'Nuovo album' }
            }) }}
        </div>
    {% else %}
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {% for album in paginator.items %}
                <li class="overflow-hidden rounded-panel border border-sabbia-200 bg-white">
                    <a href="{{ route('admin.gallery.edit', { id: album.id }) }}" class="block focus-ring">
                        <span class="block aspect-[16/10] overflow-hidden bg-sabbia-100">
                            {{ include('components/responsive-image.twig', {
                                key: album.coverPhoto ? album.coverPhoto.storageKey : null,
                                collection: 'gallery',
                                alt: 'Copertina dell album ' ~ album.title,
                                size: 'medium',
                                class: 'h-full w-full object-cover', sizes: '400px'
                            }) }}
                        </span>
                    </a>

                    <div class="p-4">
                        <div class="flex items-start justify-between gap-2">
                            <h2 class="min-w-0 font-display text-base font-bold text-viola-900">
                                <a href="{{ route('admin.gallery.edit', { id: album.id }) }}"
                                   class="hover:text-viola-700 focus-ring rounded">{{ album.title }}</a>
                            </h2>
                            <span class="badge shrink-0 {{ album.status == 'published' ? 'badge-successo' : (album.status == 'archived' ? 'badge-neutro' : 'badge-attenzione') }}">
                                {{ album.statusLabel }}
                            </span>
                        </div>

                        <p class="mt-1 text-xs text-sabbia-500">
                            {{ album.categoryLabel }} - {{ album.photosLabel }}
                            {% if album.eventDate %} - {{ album.eventDate|data_numerica }}{% endif %}
                        </p>

                        <div class="mt-3 flex flex-wrap items-center gap-1.5">
                            <a href="{{ route('admin.gallery.edit', { id: album.id }) }}" class="btn-secondario btn-piccolo">
                                {{ include('components/icon.twig', { name: 'upload', class: 'h-3.5 w-3.5' }) }}
                                Gestisci foto
                            </a>
                            {% if album.isPublished %}
                                <a href="{{ route('gallery.show', { slug: album.slug }) }}" target="_blank" rel="noopener"
                                   class="btn-fantasma btn-piccolo">
                                    {{ include('components/icon.twig', { name: 'external', class: 'h-3.5 w-3.5' }) }}
                                    <span class="sr-only">Vedi sul sito</span>
                                </a>
                            {% endif %}
                            {{ include('components/admin-delete-button.twig', {
                                action: route('admin.gallery.destroy', { id: album.id }),
                                question: 'Eliminare album e tutte le sue foto?'
                            }) }}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>

        {{ include('components/pagination.twig', { paginator: paginator }) }}
    {% endif %}
{% endblock %}
