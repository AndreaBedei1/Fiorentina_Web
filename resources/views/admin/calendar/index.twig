{#
  Calendario partite: un pulsante, e basta.

  Le partite arrivano dal fornitore e si guardano sul sito, dove le guarda
  chiunque. Qui non c'e niente da amministrare: l'unica cosa che un
  amministratore puo fare e chiedere di riallineare il calendario adesso,
  senza aspettare il cron della notte.
#}
{% extends 'layouts/admin.twig' %}

{% block content %}
    {{ include('components/admin-page-header.twig', { title: 'Calendario partite' }) }}

    <div class="pannello">
        <div class="pannello-corpo">
            <form action="{{ route('admin.calendar.sync') }}" method="post">
                {{ csrf_field()|raw }}
                <button type="submit" class="btn-primario">
                    {{ include('components/icon.twig', { name: 'ball', class: 'h-4 w-4' }) }}
                    Sincronizza
                </button>
            </form>
        </div>
    </div>
{% endblock %}
