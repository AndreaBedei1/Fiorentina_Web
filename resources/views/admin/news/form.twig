{% extends 'layouts/admin.twig' %}

{% block content %}
    {% set isNew = article is null %}

    {{ include('components/admin-page-header.twig', {
        title: isNew ? 'Nuova notizia' : 'Modifica notizia',
        back: { url: route('admin.news.index'), label: 'Torna alle notizie' }
    }) }}

    <form action="{{ isNew ? route('admin.news.store') : route('admin.news.update', { id: article.id }) }}"
          method="post" enctype="multipart/form-data" class="grid gap-5 lg:grid-cols-3">
        {{ csrf_field()|raw }}

        <div class="space-y-5 lg:col-span-2">

            {# --- Testo --- #}
            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Contenuto</h2>
                </div>

                <div class="pannello-corpo space-y-4">

                    <div>
                        <label for="campo-title" class="campo-label" data-required>Titolo</label>
                        <input type="text" id="campo-title" name="title" required maxlength="200"
                               value="{{ old('title', isNew ? '' : article.title) }}"
                               class="campo-input text-base"
                               {% if has_error('title') %}aria-invalid="true"{% endif %}>
                        {% if has_error('title') %}
                            <p class="campo-errore">
                                {{ include('components/icon.twig', { name: 'alert', class: 'h-4 w-4' }) }}
                                {{ error('title') }}
                            </p>
                        {% endif %}
                    </div>

                    {{ include('components/field.twig', {
                        name: 'excerpt', label: 'Estratto', type: 'textarea', rows: 3, maxlength: 400,
                        value: old('excerpt', isNew ? '' : article.excerpt),
                        help: 'Poche righe di anteprima, mostrate nell elenco delle notizie.'
                    }) }}

                    {# --- Testo della notizia ---
                       La casella di testo resta nel documento, nascosta: e quella
                       che il modulo invia, ed e anche cio che si vede se il
                       JavaScript non parte. #}
                    <div x-data="editorTesto">
                        <label for="campo-content" class="campo-label">Testo della notizia</label>

                        <div x-ref="barra" hidden
                             class="mt-1 flex flex-wrap gap-1 rounded-t-lg border border-b-0 border-sabbia-300 bg-sabbia-50 p-1.5">
                            {% set strumenti = [
                                { comando: 'titolo',         etichetta: 'Titolo',   aiuto: 'Titolo di sezione' },
                                { comando: 'sottotitolo',    etichetta: 'Sottotitolo', aiuto: 'Titolo piu piccolo' },
                                { comando: 'paragrafo',      etichetta: 'Testo',    aiuto: 'Testo normale' },
                                { comando: 'grassetto',      etichetta: 'G',        aiuto: 'Grassetto' },
                                { comando: 'corsivo',        etichetta: 'C',        aiuto: 'Corsivo' },
                                { comando: 'elencoPuntato',  etichetta: 'Elenco',   aiuto: 'Elenco puntato' },
                                { comando: 'elencoNumerato', etichetta: 'Elenco numerato', aiuto: 'Elenco numerato' }
                            ] %}

                            {% for strumento in strumenti %}
                                <button type="button"
                                        data-comando="{{ strumento.comando }}"
                                        @mousedown.prevent="trattieni"
                                        @click="applica"
                                        title="{{ strumento.aiuto }}"
                                        class="rounded px-2.5 py-1.5 text-xs font-semibold text-viola-900 transition hover:bg-white hover:shadow-sm focus-ring
                                               {{ strumento.comando == 'grassetto' ? 'font-extrabold' : '' }}
                                               {{ strumento.comando == 'corsivo' ? 'italic' : '' }}">
                                    {{ strumento.etichetta }}
                                </button>
                            {% endfor %}
                        </div>

                        <div x-ref="foglio"
                             contenteditable="true"
                             role="textbox"
                             aria-multiline="true"
                             aria-label="Testo della notizia"
                             @input="aggiorna"
                             @blur="aggiorna"
                             @paste="incolla"
                             class="foglio-editabile min-h-64 rounded-b-lg border border-sabbia-300 bg-white px-4 py-3
                                    focus:border-viola-500 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-viola-500/25"></div>

                        <textarea x-ref="sorgente" id="campo-content" name="content" rows="16"
                                  class="campo-textarea font-mono text-sm">{{ old('content', isNew ? '' : article.content) }}</textarea>

                        <p class="campo-aiuto">
                            Seleziona il testo e premi un pulsante per dargli la forma che vuoi.
                        </p>
                    </div>
                </div>
            </section>
        </div>

        {# --- Colonna laterale --- #}
        <div class="space-y-5 lg:col-span-1">

            <section class="pannello">
                <div class="pannello-testata">
                    <h2 class="font-display text-base font-bold text-viola-900">Immagine principale</h2>
                    <span class="text-xs text-sabbia-500">Facoltativa</span>
                </div>

                <div class="pannello-corpo space-y-4">
                    {% if not isNew and article.imageKey %}
                        <figure class="overflow-hidden rounded-card bg-sabbia-100">
                            {{ include('components/responsive-image.twig', {
                                key: article.imageKey, collection: 'news',
                                alt: article.imageAlt ?? article.title, size: 'medium',
                                class: 'aspect-[16/10] w-full object-cover', sizes: '400px'
                            }) }}
                        </figure>

                        <label class="flex items-start gap-2 text-sm text-sabbia-700">
                            <input type="checkbox" name="remove_image" value="1" class="campo-checkbox mt-0.5">
                            <span>Rimuovi l'immagine attuale</span>
                        </label>
                    {% endif %}

                    <div x-data="immagineDescritta" @change="controlla" class="space-y-4"
                         data-gia-presente="{{ (not isNew and article.imageKey) ? '1' : '0' }}">
                        {{ include('components/field.twig', {
                            name: 'image', label: isNew ? 'Carica immagine' : 'Sostituisci immagine', type: 'file',
                            accept: 'image/jpeg,image/png,image/webp',
                            help: 'Formati accettati: JPG, PNG, WebP. Consigliato almeno 1200 pixel di larghezza.'
                        }) }}

                        {{ include('components/field.twig', {
                            name: 'image_alt', label: 'Testo alternativo', maxlength: 200,
                            required: not isNew and article.imageKey,
                            value: old('image_alt', isNew ? '' : article.imageAlt),
                            help: 'Come descriveresti la fotografia a chi non puo vederla. Compare al posto dell immagine quando questa non si carica.'
                        }) }}
                    </div>
                </div>
            </section>

            {# Il pulsante sta in fondo alla colonna, dopo l'immagine: si preme
               quando si e finito, e finire vuol dire anche aver deciso se una
               fotografia ci va oppure no. #}
            <div class="pannello">
                <div class="pannello-corpo">
                    <button type="submit" class="btn-primario w-full text-base">
                        {{ isNew ? 'Pubblica' : 'Salva le modifiche' }}
                    </button>
                    <p class="mt-2 text-center text-xs text-sabbia-500">
                        {% if isNew %}
                            La notizia compare sul sito con la data di oggi.
                        {% else %}
                            Pubblicata il {{ article.publishedAt|data_ora }}.
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
