{
    "name": "baraonda/fiorentina-web",
    "description": "Sito ufficiale del gruppo organizzato di tifosi Baraonda Fiorentina: portale pubblico + CMS proprietario.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6",
        "symfony/mailer": "^7.1",
        "monolog/monolog": "^3.7",
        "intervention/image": "^3.9",
        "symfony/html-sanitizer": "^7.1",
        "cocur/slugify": "^4.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "symfony/var-dumper": "^7.1"
    },
    "suggest": {
        "ext-imagick": "Driver immagini preferito in produzione (Aruba lo espone). In assenza il progetto usa GD.",
        "ext-gd": "Driver immagini di fallback.",
        "ext-exif": "Necessario per la normalizzazione dell'orientamento delle fotografie.",
        "ext-curl": "Necessario per le API calcio/social.",
        "ext-sodium": "Usato per la cifratura simmetrica dei token applicativi.",
        "ext-intl": "Migliora la traslitterazione degli slug."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeds/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "@php scripts/migrate.php",
        "migrate:fresh": "@php scripts/migrate.php --fresh",
        "seed": "@php scripts/seed.php",
        "make:admin": "@php scripts/create-admin.php",
        "mail:test": "@php scripts/test-mail.php",
        "football:check": "@php scripts/check-football-api.php",
        "social:sync": "@php scripts/sync-social.php",
        "media:clean": "@php scripts/pulisci-media.php",
        "lint:views": "@php scripts/lint-views.php",
        "lint:rotte": "@php scripts/lint-rotte.php",
        "lint": ["@lint:views", "@lint:rotte"],
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "serve": "@php -S 127.0.0.1:8080 -t public public/router.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
