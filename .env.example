# =============================================================================
#  Baraonda Fiorentina - configurazione ambiente
# =============================================================================
#  Copia questo file in `.env` e compila i valori.
#  `.env` NON deve mai essere committato ne caricato in una cartella pubblica.
#
#      cp .env.example .env
#      php scripts/generate-key.php     # genera APP_KEY
# =============================================================================

# -----------------------------------------------------------------------------
#  Applicazione
# -----------------------------------------------------------------------------
# local | production
APP_ENV=local
APP_DEBUG=true
APP_NAME="Baraonda Fiorentina"
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it

# Chiave applicativa a 32 byte, base64. Generala con: php scripts/generate-key.php
# Serve per firmare cookie/token: cambiarla invalida sessioni e token pendenti.
APP_KEY=

# Mette il sito pubblico in manutenzione lasciando accessibile /admin.
APP_MAINTENANCE=false

# Forza il redirect a HTTPS (attivare in produzione).
FORCE_HTTPS=false

# Numero di proxy fidati davanti all'applicazione. Su Aruba Easy tenere 0.
TRUSTED_PROXIES=0

# -----------------------------------------------------------------------------
#  Database (MySQL 8)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=baraonda
DB_USERNAME=baraonda
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Database usato dalla suite di integration test (viene azzerato a ogni run).
DB_TEST_DATABASE=baraonda_test

# -----------------------------------------------------------------------------
#  Sessioni e sicurezza
# -----------------------------------------------------------------------------
SESSION_NAME=baraonda_session
# Minuti di inattivita prima del logout automatico degli amministratori.
SESSION_LIFETIME=120
# Impone il flag Secure sul cookie di sessione (obbligatorio in produzione).
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Tentativi di login consentiti prima del blocco temporaneo, e durata blocco (minuti).
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# Invii consentiti dal form contatti per indirizzo IP nella finestra indicata.
CONTACT_MAX_ATTEMPTS=5
CONTACT_DECAY_MINUTES=60

# Content-Security-Policy: report-only durante il rodaggio, enforce a regime.
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# -----------------------------------------------------------------------------
#  Email
# -----------------------------------------------------------------------------
# log    -> scrive i messaggi in storage/logs/mail/*.eml (default in locale)
# smtp   -> invio reale via SMTP
# null   -> scarta i messaggi
MAIL_MAILER=log

# --- Aruba (produzione) ------------------------------------------------------
MAIL_HOST=smtps.aruba.it
MAIL_PORT=465
# tls | ssl | null
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Gmail (comodo per le prove) ---------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=indirizzo@gmail.com
# MAIL_PASSWORD=        <- "password per le app", non quella dell account
#
# La password per le app si genera da Account Google > Sicurezza e richiede la
# verifica in due passaggi attiva. Se MAIL_FROM_ADDRESS e diverso da
# MAIL_USERNAME, Gmail riscrive il mittente: tienili uguali.

MAIL_FROM_ADDRESS=noreply@baraondafiorentina.it
MAIL_FROM_NAME="Baraonda Fiorentina"

# Destinatari operativi (sovrascrivibili dal pannello Impostazioni).
MAIL_ORDERS_TO=merchandising@baraondafiorentina.it
MAIL_CONTACT_TO=info@baraondafiorentina.it

# -----------------------------------------------------------------------------
#  API calcio  (facolta: il sito funziona anche senza chiave, con provider mock)
# -----------------------------------------------------------------------------
# mock | apifootball | football-data
FOOTBALL_PROVIDER=mock
# Con "mock" le partite sono inventate: il sito resta navigabile senza chiave.
#
# Per i dati veri: FOOTBALL_PROVIDER=football-data e la chiave qui sotto.
# Si richiede gratis su https://www.football-data.org/client/register
# Il piano gratuito comprende la Serie A, 10 richieste al minuto: il cron ne
# fa due per esecuzione, due volte al giorno.
#
# Prima di fidarti, provala:  php scripts/check-football-api.php
# Dice se la chiave funziona e quali partite arrivano davvero.
FOOTBALL_API_KEY=

# Serve solo al fornitore "apifootball" (api-sports.io).
FOOTBALL_API_BASE=https://v3.football.api-sports.io

# 0 = il fornitore cerca la squadra per nome fra quelle di Serie A.
# Con "apifootball" va invece indicato a mano: la Fiorentina e 502.
FOOTBALL_TEAM_ID=0
FOOTBALL_SEASON=2026

# Ogni quanti minuti considerare validi i dati gia scaricati.
FOOTBALL_CACHE_TTL=360

# -----------------------------------------------------------------------------
#  Social  (facolta: senza token si usano i provider mock)
# -----------------------------------------------------------------------------
SOCIAL_PROVIDER=mock

META_APP_ID=
META_APP_SECRET=

INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=

FACEBOOK_TOKEN=
FACEBOOK_PAGE_ID=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# -----------------------------------------------------------------------------
#  Immagini
# -----------------------------------------------------------------------------
# imagick | gd | auto  (auto = imagick se disponibile, altrimenti gd)
IMAGE_DRIVER=auto
IMAGE_QUALITY_WEBP=82
IMAGE_QUALITY_JPEG=85

# Filigrana applicata alle fotografie della galleria.
WATERMARK_ENABLED=true
# bottom-right | bottom-left | top-right | top-left | center | tiled
WATERMARK_POSITION=bottom-right
WATERMARK_OPACITY=38
# Larghezza della filigrana in percentuale sul lato lungo della foto.
WATERMARK_SCALE=18

# -----------------------------------------------------------------------------
#  Cron
# -----------------------------------------------------------------------------
# Token richiesto per l'esecuzione degli script di cron via HTTP.
# Lasciare vuoto se il cron viene eseguito da riga di comando (consigliato).
CRON_TOKEN=

# -----------------------------------------------------------------------------
#  Seed di sviluppo
# -----------------------------------------------------------------------------
# Credenziali del primo SUPER_ADMIN generato da `php scripts/seed.php`.
# Valgono SOLO in APP_ENV=local: in produzione il seed rifiuta di crearle.
DEV_ADMIN_EMAIL=admin@baraondafiorentina.test
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME="Super Admin Demo"
